% ref.satyg — SATySFi 0.1 stdlib `Ref`, vendored for Legacy packaging
% (docs/plans/satysfi-0-1-0-support.md §2 P2 / §4 phase 6).
% Source: saphe-split@b836d512:lib-satysfi/packages/stdlib/stdlib.0.0.1/
%   src/ref.satyg — transliteration deltas: T3 only (`val persistent ~name
%   … = …` -> `val name … = …`). `ref int`'s sig type is the built-in
%   `MonoType::Ref` postfix constructor (`typecheck.rs:552`, `name_to_mono`
%   `"ref" => reff(arg_ty)`) — landed, no delta needed. `<-`/`!` (`Expr::
%   Overwrite`/`UnopExclamTok`) already work generically on any in-scope
%   name holding a `Value::Ref`, not just `let mutable`-introduced ones —
%   `increment`/`decrement`'s parameter `r` is exactly that case.

module Ref :> sig
  val increment : ref int -> unit
  val decrement : ref int -> unit
end = struct

  val increment r =
    r <- !r + 1

  val decrement r =
    r <- !r - 1

end
