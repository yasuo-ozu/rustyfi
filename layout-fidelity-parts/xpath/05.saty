@require: stdjareport
@require: itemize
@require: list
@require: annot
@require: color
@require: math

@require: xpath/xpath
@require: shared/util

let-inline ctx \test-path m gs =
    let ((x1, y1), (x2, y2)) = match gs with
        | [] -> ((0pt, 0pt), (0pt, 0pt))
        | g::gs -> gs |> List.fold-left (fun ret g -> (
              let (bb1, bb2) = get-graphics-bbox g in
              concat-bbox ret (bb1,bb2)
        )) (get-graphics-bbox g)
    in
    let b = 0.1pt in
    let m = m +' (b *' 0.5) in
    let w = x2 -' x1 +' (m *' 2.0) in
    let h = y2 -' y1 +' (m *' 2.0) in
    inline-graphics w h 0pt (fun (x, y) -> (
        (
            start-path (x, y) |> line-to (x +' w, y)
            |> line-to (x +' w, y +' h) |> line-to (x, y +' h)
            |> close-with-line |> stroke 1pt Color.black
        )::(
            gs |> List.map (shift-graphics (x -' x1 +' m, y -' y1 +' m))
        )
    ))

let-block +test-path m gs = '< +p { \test-path(m)(gs); } >

let ctx = get-initial-context 16pt (command \math) in
document (|
  title = {Xwrz 05};
  author = {txst};
|) '<
     +chapter{ぺぎぼ にぎぬこぬぎ}<
        +section{がぱぎ どぎ へんぎぎぎぎ}<
             +p {
                 \code(`deformate-path-by-func f p`);を ぶぎめぬぎぎ、 あえ われぎぱ かんぎぎぎぎ\code(`f: point -> point`);を ぶぎめぎぬ がぱぎ\code(`p`);を へんぎぎ ぎぎぎぎぎぬ ぎぎぎぎぎぬ。 これぐ \code(`linear-transform-path`);どぎ ぎっぎぎんぎ りぼぎぬ。 れぎぎぎ いぎあ ぐ かんぎぎぎぎ\code(`(x, y) -> (x, y *' (x *' 0.5)')`);を ぶぎめぎぬ ぐろぎぎ がぱぎ を あぎぎぎぎ がぱぎ に へんぎぎ ぎぬ れぎぎ りぼぎぬ。
             }
             +code(```
 XPath.(
     let f = fun (x, y) -> (x, y +' (x *' 0.5)) in
     let p = start-path (0pt, 0pt)
        |> bezier-to (0cm, 1cm) (1cm, 1cm) (1cm, 0cm)
        |> bezier-to (1cm, -1cm) (2cm, -1cm) (2cm, 0cm)
        |> bezier-to (2cm, 1cm) (3cm, 1cm) (3cm, 0cm)
        |> bezier-to (3cm, -1cm) (4cm, -1cm) (4cm, 0cm)
        |> bezier-to (4cm, 1cm) (5cm, 1cm) (5cm, 0cm)
        |> terminate-path
     in
     [
         p |> stroke 2pt (Color.black);
         p |> deformate-path-by-func f |> stroke 2pt (Color.blue)
     ]
 )
             ```);
             +p {
                 ぐ いぎぁ どぎ ぐぎぎぎぎぎぎぎぎぎぎ を しゅつぎょぎ りぼぎぬ。
             }
             +test-path (5pt) (
                 XPath.(
                     let f = fun (x, y) -> (x, y +' (x *' 0.5)) in
                     let p = start-path (0pt, 0pt)
                        |> bezier-to (0cm, 1cm) (1cm, 1cm) (1cm, 0cm)
                        |> bezier-to (1cm, -1cm) (2cm, -1cm) (2cm, 0cm)
                        |> bezier-to (2cm, 1cm) (3cm, 1cm) (3cm, 0cm)
                        |> bezier-to (3cm, -1cm) (4cm, -1cm) (4cm, 0cm)
                        |> bezier-to (4cm, 1cm) (5cm, 1cm) (5cm, 0cm)
                        |> terminate-path
                     in
                     [
                         p |> stroke 2pt (Color.black);
                         p |> deformate-path-by-func f |> stroke 2pt (Color.blue)
                     ]
                 )
             );
             +p {
                 \code(`deformate-path delta pp p`);を ぶぎめぬぎぎ、 あえ われぎぱ みぶぱ がぱぎ\code(`pp`);に そぎわぎぬ ぎぎぎ がぱぎ\code(`p`);を へんぎぎ ぎぎぎぎぎぬ ぎぎぎぎぎぬ。 がぱぎ\code(`p`);ぐ ざぎょぎぎ\code(`(0pt, 0pt)`);から\code(`x > 0`);ぼぎぎぎ に あぎぎ される ぎっぎぎぎ ぎぎぎ、 ぐぬ ぎぎ ぎょぎぎぎぬ\code(`x = 0`);を みぶぱ がぱぎ\code(`pp`);に あぎわぎぬ ぎぎぎぎ へんぎぎ りぼぎぬ。
             }
             +p {
                 いぎぁ ぐ ぐろぎぎ がぱぎ を あかぎぎぎぎ みぶぱ がぱぎ を ぶぎめぎぬ へんぎぎ ぎ あぎぎぎぎ がぱぎ を えぎぬ れぎぎ りぼぎぬ。
             }
             +test-path (5pt) (
                 XPath.(
                     let pp = start-path (0pt, 0pt)
                         |> bezier-to (0cm, 0cm) (3cm, 3cm) (5cm, 3cm)
                         |> bezier-to (8cm, 3cm) (10cm, 0cm) (10cm, 0cm)
                     in
                     let p = start-path (0pt, 0pt)
                        |> bezier-to (0cm, 1cm) (1cm, 1cm) (1cm, 0cm)
                        |> bezier-to (1cm, -1cm) (2cm, -1cm) (2cm, 0cm)
                        |> bezier-to (2cm, 1cm) (3cm, 1cm) (3cm, 0cm)
                        |> bezier-to (3cm, -1cm) (4cm, -1cm) (4cm, 0cm)
                        |> bezier-to (4cm, 1cm) (5cm, 1cm) (5cm, 0cm)
                        |> terminate-path
                     in
                     [
                         p |> stroke 1pt (Color.black);
                         pp |> terminate-path |> stroke 1pt (Color.red);
                         p |> deformate-path 1pt pp |> stroke 2pt (Color.blue)
                     ]
                 )
             );
        >
     >
>
