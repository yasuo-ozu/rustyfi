% The 0.0.6-syntax twin of v01-minimal.saty (rustyfi-lang/tests/v01_slice1.rs
% — semantic-equivalence proof): same content, spelled with 0.0.6's
% `let-rec`/`let-mutable`/`;`-lists/no-`end`-match surface. The extra bindings
% the v01 library declares (type/val rec/(+++)) live in this document's own
% prelude here, since stdja-mini stays frozen.

@require: stdja-mini

type answer-shape = | Known of int | Unknown
let-rec sum-list lst = match lst with
  | []      -> 0
  | x :: xs -> x + sum-list xs
let (+++) a b = a + b * 2
let answer = embed-string (arabic (match Some 41 with
  | None -> 0
  | Some n -> n + 1))
in
let-rec even n = if n <= 0 then true else odd (n - 1)
  and odd n = if n <= 0 then false else even (n - 1) in
let-mutable count <- 41 in
let () = (count <- !count + 1) in
let total  = embed-string (arabic (sum-list [1; 2; 3; 4])) in
let counted = embed-string (arabic (!count)) in
let parity = embed-string (if even 4 then `even` else `odd`) in
let label = match Known 7 with
  | Known n -> embed-string (arabic (n +++ 0))
  | Unknown -> embed-string `?`
in
document (|title = `v01`;|) '<
  +p { The answer is #answer;. }
  +p { \emph{ Emphasis } works. }
  +p { Sum #total; count #counted; parity #parity; label #label;. }
>
