% code.satyh — SATySFi 0.1 `code` package, FUNCTOR-FREE PORT STAND-IN
% (CP7 item 3 / §4-G). Source:
% saphe-split@b836d512:lib-rustyfi/packages/code/code.0.0.1/src/
%   code.satyh (151 lines) — upstream `Code` is a FUNCTOR (`module Make =
%   fun(X : Settings) -> struct … end`, named signatures `Settings`/
%   `Interface`, functor application `Default = Make DefaultSettings`,
%   `Console = Make ConsoleSettings`). Functors (2f) and named-signature
%   ascription for nested module members in a sig (2d-3) are both
%   deliberately OFF the std-ja critical path
%   (vendoring-scout.md gap; doc-class-capstone-road.md §0: "the ONLY
%   std-ja dependency that needs 2d-3/2f is the code package — and std-ja
%   touches it in exactly ONE expression: `set-code-text-command (command
%   \Code.Default.code)`").
%
% STAND-IN: a PLAIN (unsealed — no `:>` anywhere, so no signature
% ascription of any kind is invoked) module `Code` with a nested plain
% module `Default`, replicating upstream's `Make DefaultSettings` scheme
% BODY once, monomorphically, instead of through a functor + a settings
% record. `\code` (upstream `Interface.\code`, the ONE member std-ja
% actually calls) is faithfully reproduced from `Make`'s body
% (`set-code-font` + `script-guard`); `DefaultSettings`'s field values
% (`font-family = FontLatinModern.mono`, `text-color = Gray(0.)`) are
% inlined directly. `+code`/`\d-code`/`+file-code`/`\file-code`/`Console`/
% `+console`/`\console`/the `scheme`/`Make`/`Settings`/`Interface` members
% are DROPPED — std-ja never references them, and reproducing them
% faithfully would mean either resurrecting the functor (out of scope) or
% hand-duplicating the whole block-frame/split-into-lines scheme for no
% consumer. `\d-code`'s block-embedding shape is exactly what
% `+code`/`scheme` would need, so an inline-only stand-in is the smallest
% faithful cut.
%
% Nested plain-module definitions (`module Default = struct … end` inside
% the outer unsealed `module Code = struct … end`) are Sub-slice 2a
% surface — landed, and exercised by `v01_modules.rs`'s own nested-module
% test. Two-level qualified command reference (`\Code.Default.code` /
% `command \Code.Default.code`) is likewise landed end-to-end (the lexer's
% `scan_dotted` loop is depth-general, not fixed at one segment).

@require: font-latin-modern

module Code = struct

  module Default = struct

    val inline ctx \code code =
      script-guard Latin
        (read-inline
          (ctx |> set-font Latin (FontLatinModern.mono, 1., 0.)
               |> set-hyphen-penalty 100000)
          (embed-string code))

  end

end
