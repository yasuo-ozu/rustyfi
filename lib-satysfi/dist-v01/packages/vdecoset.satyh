% vdecoset.satyh — SATySFi 0.1 stdlib `VDecoSet`, vendored for Legacy
% packaging (docs/plans/satysfi-0-1-0-support.md §2 P2 / §4 phase 6).
% Source: saphe-split@b836d512:lib-satysfi/packages/stdlib/stdlib.0.0.1/
%   src/vdecoset.satyh — transliteration deltas:
%   - T1: `use Color` / `use Graphics` / `use Path` dropped; `@require:
%     color`, `@require: graphics`, `@require: path` added.
%   - G10 (newly discovered this wave, see `hdecoset.satyh`'s banner for
%     the full writeup): EXPRESSION-LEVEL named `let NAME param* = … in
%     …` bindings (`Expr::LetIn`, `params: Vec<VarTok>`) accept neither
%     wildcard `_` params NOR compound (e.g. tuple) patterns — only bare
%     variable names. Every local `decoS`/`decoH`/`decoM`/`decoT`/
%     `shadowL`/`shadowI` helper here binds a tuple-patterned first param
%     `(x, y)` (plus `quote-round`'s four helpers, which also ignore
%     their second param via `_`). Worked around uniformly by switching
%     every such local to `let NAME = fun pat1 .. patN -> body in`
%     (`Expr::Fun`'s `params: Vec<PatBot>` accepts both tuple patterns
%     and wildcards, and `Expr::LetIn`'s VALUE position accepts any
%     expression) — a pure spelling change, no behavior difference.
%   Otherwise byte-faithful: `unite-graphics` (A12, called bare — a
%   global primitive, not `Graphics`-qualified, matching upstream's own
%   bare call), `Gray(0.5)`/`Color.black` (flat ctor / qualified
%   constant) are all landed.
%
%   Affected by G8 (see `graphics.satyh`'s banner): `deco-set` is a bare
%   sig type name this port's v1 sealing width check doesn't recognize,
%   so `:>` fails `compile_document_v1`'s seal-width pass (pre-existing
%   gap). Tested via the "value bar" (`compile_v01_via_loader`).

@require: color
@require: graphics
@require: path

module VDecoSet :> sig
  val empty : deco-set
  val simple-frame-stroke : length -> color -> deco-set
  val simple-frame : length -> color -> color -> deco-set
  val paper : deco-set
  val quote-round : length -> length -> color -> deco-set
end = struct

  val empty =
    let deco = fun pt w h d -> Graphics.empty in
    (deco, deco, deco, deco)

  val simple-frame-stroke t scolor =
    let strokef = stroke t scolor in
    let decoS = fun (x, y) w h d ->
      strokef (Path.rectangle (x, y -' d) (x +' w, y +' h))
    in
    let decoH = fun (x, y) w h d ->
      strokef (Path.poly-line (x, y -' d) [ (x, y +' h), (x +' w, y +' h), (x +' w, y -' d) ])
    in
    let decoM = fun (x, y) w h d ->
      unite-graphics [
        strokef (Path.line (x, y -' d) (x, y +' h)),
        strokef (Path.line (x +' w, y -' d) (x +' w, y +' h)),
      ]
    in
    let decoT = fun (x, y) w h d ->
      strokef (Path.poly-line (x, y +' h) [ (x, y -' d), (x +' w, y -' d), (x +' w, y +' h) ])
    in
    (decoS, decoH, decoM, decoT)

  val simple-frame t scolor fcolor =
    let strokef = stroke t scolor in
    let gr-back x y w d h =
      fill fcolor (Path.rectangle (x, y -' d) (x +' w, y +' h))
    in
    let decoS = fun (x, y) w h d ->
      unite-graphics [
        gr-back x y w d h,
        strokef (Path.rectangle (x, y -' d) (x +' w, y +' h)),
      ]
    in
    let decoH = fun (x, y) w h d ->
      unite-graphics [
        gr-back x y w d h,
        strokef (Path.poly-line (x, y -' d) [(x, y +' h), (x +' w, y +' h), (x +' w, y -' d),])
      ]
    in
    let decoM = fun (x, y) w h d ->
      unite-graphics [
        gr-back x y w d h,
        strokef (Path.line (x, y -' d) (x, y +' h)),
        strokef (Path.line (x +' w, y -' d) (x +' w, y +' h)),
      ]
    in
    let decoT = fun (x, y) w h d ->
      unite-graphics [
        gr-back x y w d h,
        strokef (Path.poly-line (x, y +' h) [(x, y -' d), (x +' w, y -' d), (x +' w, y +' h)])
      ]
    in
    (decoS, decoH, decoM, decoT)

  val paper =
    let xshift = 2pt in
    let yshift = 1pt in
    let shadow-color = Gray(0.5) in
    let edge-color = Color.black in
    let thk = 0.5pt in
    let shadowL = fun (x, y) w h d ->
      fill shadow-color
        (Path.polygon (x +' w, y +' h) [
            (x +' w +' xshift, y +' h -' yshift),
            (x +' w +' xshift, y -' d -' yshift),
            (x +' xshift, y -' d -' yshift),
            (x, y -' d),
            (x +' w, y -' d),
        ])
    in
    let shadowI = fun (x, y) w h d ->
      fill shadow-color
        (Path.polygon (x +' w, y -' d) [
          (x +' w +' xshift, y -' d),
          (x +' w +' xshift, y +' h -' yshift),
          (x +' w, y +' h),
        ])
    in
    let decoS = fun (x, y) w h d ->
      unite-graphics [
        shadowL (x, y) w h d,
        stroke thk edge-color (Path.rectangle (x, y -' d) (x +' w, y +' h)),
      ]
    in
    let decoH = fun (x, y) w h d ->
      unite-graphics [
        shadowI (x, y) w h d,
        stroke thk edge-color
          (Path.poly-line (x, y -' d) [
            (x, y +' h),
            (x +' w, y +' h),
            (x +' w, y -' d),
          ]),
        ]
    in
    let decoM = fun (x, y) w h d ->
      unite-graphics [
        shadowI (x, y) w h d,
        stroke thk edge-color (Path.line (x, y -' d) (x, y +' h)),
        stroke thk edge-color (Path.line (x +' w, y -' d) (x +' w, y +' h)),
      ]
    in
    let decoT = fun (x, y) w h d ->
      unite-graphics [
        shadowL (x, y) w h d,
        stroke thk edge-color
          (Path.poly-line (x, y +' h) [
            (x, y -' d),
            (x +' w, y -' d),
            (x +' w, y +' h),
          ]),
      ]
    in
    (decoS, decoH, decoM, decoT)

  val quote-round qw r color =
    let decoS = fun (x, y) wid h d ->
      fill color (Path.rectangle-round-left r (x, y -' d) (x +' qw, y +' h))
    in
    let decoH = fun (x, y) wid h d ->
      fill color (Path.rectangle-round-left-upper r (x, y -' d) (x +' qw, y +' h))
    in
    let decoM = fun (x, y) wid h d ->
      fill color (Path.rectangle (x, y -' d) (x +' qw, y +' h))
    in
    let decoT = fun (x, y) wid h d ->
      fill color (Path.rectangle-round-left-lower r (x, y -' d) (x +' qw, y +' h))
    in
    (decoS, decoH, decoM, decoT)

end
