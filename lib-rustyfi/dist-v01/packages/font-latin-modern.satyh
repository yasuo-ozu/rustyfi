% font-latin-modern.satyh — SATySFi 0.1 font envelope `FontLatinModern`,
% Legacy stand-in (G7 / CP6, `…/tmp/g6-g7-standins.md` §2.2). Source:
% saphe-split@b836d512:lib-rustyfi/packages/font-latin-modern/… —
% ENVELOPE-ONLY upstream (no .satyh); saphe synthesizes
% `FontLatinModern.{mono,sans} : font` from rustyfi-envelope.yaml
% `files[].opentype_single.name`. PORT STAND-IN: an ordinary `.satyh`
% module whose members call the LOCAL `load-single-font` primitive in place
% of upstream's synthesized `LoadSingleFont{path}` node — the values ARE
% real `font` handles (`Value::Font(FontKey)`), keyed by this port's
% font-store abbrev rather than by a font FILE path. No `@require:`.

module FontLatinModern :> sig
  val mono : font
  val sans : font
end = struct
  val mono = load-single-font `lmmono`
  val sans = load-single-font `lmsans`
end
