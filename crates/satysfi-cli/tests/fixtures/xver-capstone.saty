% THE CROSS-VERSION IMPORT CAPSTONE (design-cross-version-import.md's
% marquee end-to-end proof): a real SATySFi 0.1 (dev-0-1-0) document
% `@require:`-ing a REAL, unmodified upstream SATySFi 0.0.6 package —
% `lib-satysfi/dist/packages/list.satyg` (which itself `@require:`s
% `option.satyg`) — through the FULL pipeline: V0_1 lex -> cst_v1 parse ->
% loader (`load_legacy`'s X1 Q4 per-file version detection tags `list`/
% `option` as `V0_0_6`, everything else stays `V0_1`) -> `v1::lower` ->
% shared elaborate/typecheck(V0_1 whole-program, `Ast::VersionScope`-wrapped
% dependency)/eval -> line break -> page break -> PDF. `List.map`/
% `List.fold-left`/`Option.from` (all real 0.0.6-defined values, never
% stubbed) compute a number that is rendered as digits in the body text
% below — `xver_capstone.rs` asserts that EXACT number is present in the
% pdftotext output, proving the 0.0.6 package's computation genuinely
% reached the rendered PDF, not just that the program type-checked.
%
% `list`/`option` are the same version-neutral pair
% `xver_import.rs::positive_case_list_and_option_render` already proved
% work end-to-end (synthetically, via a temp-dir copy); this fixture drives
% the SAME two real corpus files straight out of `lib-satysfi/dist/
% packages/`, with no copying — see `xver_capstone.rs`'s module doc comment
% for how a single `lib_root` reaches both this `@require:` corpus target
% and the local `@import:` 0.1 scaffolding below.
@require: list
@require: option
@import: xver-capstone-helper

let mapped = List.map (fun x -> x + 10) [1, 2, 3] in
let summed = List.fold-left (fun a b -> a + b) 0 mapped in
let combined = Option.from 0 (Some summed) in
let combined-text = embed-string (arabic combined) in
let open XverCapHelper in
document (| title = `xver-capstone` |) '<
  +p {
    The cross-version sum, computed by the real upstream SATySFi 0.0.6
    List and Option packages, is #combined-text;.
  }
  +p {
    The quick brown fox jumps over the lazy dog.
  }
>
