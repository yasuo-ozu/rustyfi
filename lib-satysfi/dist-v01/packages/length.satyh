% length.satyh — SATySFi 0.1 stdlib `Length`, vendored for Legacy packaging
% (docs/plans/satysfi-0-1-0-support.md §2 P2 / §4 phase 6).
% Source: saphe-split@b836d512:lib-satysfi/packages/stdlib/stdlib.0.0.1/
%   src/length.satyh — transliteration deltas:
%   - T3: `val persistent ~name … = …` -> `val name … = …`; the `val ~lift`
%     member (`~lift : length -> code length`, body `lift-length`) and its
%     sig line are dropped outright (per-binding staging is unbuilt; the
%     0.0.6 corpus set this precedent).
%   Everything else (`<'`/`-'`/`atan2`) is landed, shared 0.0.6/0.1 operator
%   surface.

module Length :> sig
  type t = length
  val max : length -> length -> length
  val min : length -> length -> length
  val abs : length -> length
  val atan2 : length -> length -> float
end = struct

  type t = length

  val max len1 len2 =
    if len1 <' len2 then len2 else len1

  val min len1 len2 =
    if len1 <' len2 then len1 else len2

  val abs len =
    if len <' 0pt then 0pt -' len else len

  val atan2 y x =
    atan2 (y /' 1pt) (x /' 1pt)

end
