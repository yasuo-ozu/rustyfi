% font-junicode.satyh — SATySFi 0.1 font envelope `FontJunicode`, Legacy
% stand-in (docs/plans/…/doc-class-capstone-road.md §3 G7 / CP6,
% `…/tmp/g6-g7-standins.md` §2.2).
% Source: saphe-split@b836d512:lib-rustyfi/packages/font-junicode/… — this
% package is ENVELOPE-ONLY upstream (no .satyh); saphe synthesizes
% `FontJunicode.{normal,bold,italic,bold-italic} : font` from
% rustyfi-envelope.yaml `files[].opentype_single.name`. PORT STAND-IN: each
% `font` value is the abbrev STRING (G8: `font` ≡ `string` under V0_1,
% `typecheck.rs:499`); the backend resolves it via `set-font`'s name-
% heuristic / a bare `TtfFontStore::load` single-face store, so every
% abbrev collapses to the one loaded face. No `@require:`. Real 0.1
% envelope font loading (Axis B) supersedes this later.

module FontJunicode :> sig
  val normal : font
  val bold : font
  val italic : font
  val bold-italic : font
end = struct
  val normal = `Junicode`
  val bold = `Junicode-b`
  val italic = `Junicode-it`
  val bold-italic = `Junicode-bi`
end
