% Fixture: the real `page-break-two-column` — two `fun pbinfo
% -> record` scheme literals, a
% 250pt second-column x-shift, and a long body that overflows a narrow
% single-column area onto roughly HALF as many pages once split across two
% columns.

@require: stdja-mini

let ctx = get-initial-context 200pt (command \math)

let content pbinfo = (| text-origin = (72pt, 72pt); text-height = 300pt |)

let parts pbinfo =
  (| header-origin = (0pt, 0pt); header-content = block-nil;
     footer-origin = (0pt, 0pt); footer-content = block-nil |)

let columnhookf () = block-nil

let-rec repeat n f =
  if n <= 0 then block-nil
  else (f n) +++ (repeat (n - 1) f)

let paragraph n =
  line-break true true ctx (read-inline ctx {This line helps overflow the column.})

in
page-break-two-column A4Paper 250pt columnhookf content parts (repeat 30 paragraph)
