% logo.satyh — SATySFi 0.1 stdlib `Logo`, vendored for Legacy packaging
% (docs/plans/satysfi-0-1-0-support.md §2 P2 / §4 phase 6).
% Source: saphe-split@b836d512:lib-satysfi/packages/stdlib/stdlib.0.0.1/
%   src/logo.satyh — transliteration deltas:
%   - T1: `use open Inline` dropped; `@require: inline` added.
%   - T2-generalized: `use open Inline` erasure — unlike `Basic` (whose
%     bare members this port keeps flat via a special-cased ctor/type
%     carve-out, T2), `Inline`'s bare VALUE members (`kern`, `no-break`)
%     have no such carve-out, and this port's v1 grammar has no
%     module-body-level `open M` bind (`cst_v1::Bind` has no `Open`
%     variant — only the expression-level `let open M in …`,
%     `cst_v1.rs`'s `Expr::OpenIn`). Each command binding's body is
%     instead individually wrapped `let open Inline in …`, re-exposing
%     `kern`/`no-break` bare within that scope — the same qualified-open
%     mechanism `v01_modules.rs`'s `let_open_reexposes_bare_access`
%     proves, and `context.satyh`'s own banner already used for a
%     command VALUE (`command \math`); here it's an ordinary value open.
%     `read-inline`/`get-font-size`/`set-manual-rising`/`set-font-size`/
%     `script-guard` are global primitives, referenced bare either way.
%   No other deltas.

@require: inline

module Logo :> sig
  val \SATySFi : inline []
  val \LaTeX : inline []
  val \TeX : inline []
end = struct

  val inline ctx \SATySFi =
    let open Inline in
    let size = get-font-size ctx in
    let f = read-inline ctx in
    let fd = ctx |> set-manual-rising (0pt -' (size *' 0.25)) |> read-inline in
    let ib =
      f {SAT} ++ kern (size *' 0.15) ++ fd {Y} ++ f {SF} ++ kern (size *' 0.05) ++ fd {I}
    in
    script-guard Latin (no-break ib)

  val inline ctx \LaTeX =
    let open Inline in
    let size = get-font-size ctx in
    let f = read-inline ctx in
    let fA = ctx |> set-font-size (size *' 0.7)
                 |> set-manual-rising (size *' 0.2)
                 |> read-inline
    in
    let fE = ctx |> set-manual-rising (0pt -' (size *' 0.25))
                 |> read-inline
    in
    let ib =
      f {L} ++ kern (size *' 0.2) ++ fA {A}
        ++ f {T} ++ kern (size *' 0.125) ++ fE {E} ++ f {X}
    in
    script-guard Latin (no-break ib)

  val inline ctx \TeX =
    let open Inline in
    let size = get-font-size ctx in
    let f = read-inline ctx in
    let fE = ctx |> set-manual-rising (0pt -' (size *' 0.25))
                 |> read-inline
    in
    let ib =
      f {T} ++ kern (size *' 0.125) ++ fE {E} ++ f {X}
    in
    script-guard Latin (no-break ib)

end
