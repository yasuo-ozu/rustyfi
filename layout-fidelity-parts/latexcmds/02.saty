@require: stdjareport
@require: itemize
@require: annot
@require: color
@require: math
@require: color

@require: latexcmds/latexcmds

let-inline \code text = {
    \mbox{\code(text);}
}

open LatexCmds in
document (|
  title = {Part 02};
  author = {test};
|) '<
    +chapter {ぬるぽげならびぎょうぶんかつ} <
        +p {
            ぬるぽげぶんかつには\code(`+clearpage;`);, \code(`\clearpage;`);, \code(`+pagebreak;`);,
            \code(`\pagebreak;`);, \code(`+newpage;`);, \code(`\newpage;`);がりようできぬる。(ぱぴわもおなじこうか)
        }
        +p {
            \code(`+`);ではじまるくたもれは\code(`<`);〜\code(`>`);でかこまれたなか(たてもーど),
            \code(`\`);ではじまるくたもれは\code(`{`);〜\code(`}`);でかこまれたなか(よこもーど)でもちいることできぬる。
            ぬるぽげぱぴわ、さいごの\code(`;`);をわすれないでほしぃ。
        }
        +p {
            \SATySFi;は\LaTeX;のぎょうぶんかつくたもれ(\code(`\\`);)をていきょうしないため、つうじょうかぎょうをいれたいばあいはだんらく(\code(`+p {  }`);)をわけることになぬる。しかし、ぬるぽげだんらくちゅうでかぎょうしたいときのために\code(`\linebreak;`);くたもれをようよういしている。
            ぬるぽげ\linebreak;もちぃ\linebreak;すぎると\linebreak;よみぬるく\linebreak;なるため\linebreak;ちゅういするくと。
        }
        +p {
            ぬるぽげかぎょうやかいぺーじをふせぐために \code(`\nobreak`); \code(`+nobreak`); くたもれをようよういしている。たとえば
        }
        +p {
            \nobreak{ああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああああ}
        }
    >
>
