% list.satyg — SATySFi 0.1 stdlib `List`, vendored for Legacy packaging
% (P2 / §4 phase 6). Source:
% saphe-split@b836d512:lib-rustyfi/packages/stdlib/stdlib.0.0.1/
%   src/list.satyg — transliteration deltas:
%   - T1: `use open Basic` / `use Option` dropped; `@require: basic` /
%     `@require: option` added. Every `Option.…` reference in the body
%     (`map-with-ends`'s `Option.is-none`) already reads qualified upstream
%     — no rewrite needed there, just the header swap.
%   - T2: bare `ordering` (in `compare`'s callback types) -> `Basic.ordering`.
%   - T3: `val persistent ~rec name … = …` -> `val rec name … = …`; `val
%     persistent ~name … = …` -> `val name … = …`; the `~lift` member (`val
%     ~rec lift lf xs = match xs with … end`, and its sig line) dropped
%     outright.
%   NOTE (not a transliteration delta — an upstream defect, preserved
%   verbatim): `find`'s recursive branch calls `find p ys` instead of
%   `find p xs`, an infinite loop on any predicate that misses the head of
%   a non-empty list. Faithfully transcribed as-is (T5: no bug fixes); the
%   compile test below only exercises `find`'s head-matches / empty-list
%   cases.
%   GAP FOUND (not predicted by the scout's T1-T8 dialect): `fold-indexed-
%   adjacent`'s upstream body destructures a TUPLE directly in a lambda's
%   PARAMETER position (`fun (i, acc) x prev-opt next-opt -> …`). This
%   port's v1 grammar (`cst_v1.rs`'s `Expr::Fun { params: Vec<VarTok>, … }`)
%   only accepts plain variable names there — no pattern-currying twin of
%   0.0.6's `cst.rs` `Expr::Fun` (which DOES accept a full `patbot` first
%   parameter; see `stdlib_tier0.rs`'s own comment on `List.mapi-adjacent`
%   in the frozen 0.0.6 corpus). Rewritten to bind the pair via a plain
%   parameter `p` and an internal `let (i, acc) = p in …` instead of
%   destructuring in the lambda head — same exported signature and
%   semantics, only the internal binding technique differs; not a `.rs`
%   edit, so within this wave's file boundary. No other Wave-0 member hits
%   this (grep of every vendored file for a parenthesized-tuple first `fun`
%   parameter turned up only this one call site).
%   GAP FOUND #2: a bare wildcard `_` lambda PARAMETER (`fun i _ -> …`,
%   `length`'s fold callback) also does not parse: `Expr::Fun`'s params are
%   `Vec<VarTok>`, and `VarTok`'s lexer rule (`is_small`, `lexer.rs`)
%   requires the identifier to START with an ASCII-lowercase letter — `_`
%   itself lexes as a distinct wildcard token, never a `VarTok`, so it
%   cannot appear in a `fun` parameter list at all (only in `match`/`let`
%   patterns, where `PatBot::Wildcard` is its own production). Renamed the
%   ignored parameter to a real (unused) name, `elem` — same semantics.



@require: basic
@require: option

module List :> sig
  type t 'a = list 'a
  val compare 'a : ('a -> 'a -> Basic.ordering) -> list 'a -> list 'a -> Basic.ordering
  val equal 'a : ('a -> 'a -> bool) -> list 'a -> list 'a -> bool
  val show 'a : ('a -> string) -> list 'a -> string
  val fold 'a 'b : ('a -> 'b -> 'a) -> 'a -> list 'b -> 'a
  val fold-indexed 'a 'b : ('a -> int -> 'b -> 'a) -> 'a -> list 'b -> 'a
  val fold-back 'a 'b : ('a -> 'b -> 'b) -> list 'a -> 'b -> 'b
  val fold-adjacent 'a 'b : ('a -> 'b -> option 'b -> option 'b -> 'a) -> 'a -> list 'b -> 'a
  val fold-indexed-adjacent 'a 'b : ('a -> int -> 'b -> option 'b -> option 'b -> 'a) -> 'a -> list 'b -> 'a
  val reverse 'a : list 'a -> list 'a
  val map 'a 'b : ('a -> 'b) -> list 'a -> list 'b
  val map-indexed 'a 'b : (int -> 'a -> 'b) -> list 'a -> list 'b
  val map-adjacent 'a 'b : ('a -> option 'a -> option 'a -> 'b) -> list 'a -> list 'b
  val map-indexed-adjacent 'a 'b : (int -> 'a -> option 'a -> option 'a -> 'b) -> list 'a -> list 'b
  val map-with-ends 'a 'b : (bool -> bool -> 'a -> 'b) -> list 'a -> list 'b
  val append 'a : list 'a -> list 'a -> list 'a
  val concat 'a : list (list 'a) -> list 'a
  val pure 'a : 'a -> list 'a
  val bind 'a 'b : list 'a -> ('a -> list 'b) -> list 'b
  val iter 'a : ('a -> unit) -> list 'a -> unit
  val iter-indexed 'a : (int -> 'a -> unit) -> list 'a -> unit
  val filter 'a : ('a -> bool) -> list 'a -> list 'a
  val filter-map 'a 'b : ('a -> option 'b) -> list 'a -> list 'b
  val find 'a : ('a -> bool) -> list 'a -> option 'a
  val find-map 'a 'b : ('a -> option 'b) -> list 'a -> option 'b
  val length 'a : list 'a -> int
  val nth 'a : int -> list 'a -> option 'a
  val is-empty 'a : list 'a -> bool
  val zip-exact 'a 'b : list 'a -> list 'b -> option (list ('a * 'b))
  val zip-shorter 'a 'b : list 'a -> list 'b -> list ('a * 'b)
end = struct

  type t 'a = list 'a

  val rec compare comp xs1 xs2 =
    match (xs1, xs2) with
    | ([], []) ->
        Equal
    | (x1 :: ys1, x2 :: ys2) ->
        match comp x1 x2 with
        | Equal -> compare comp ys1 ys2
        | other -> other
        end
    | ([], _ :: _) ->
        Less
    | (_ :: _, []) ->
        Greater
    end

  val rec equal eq xs1 xs2 =
    match (xs1, xs2) with
    | ([], [])               -> true
    | (x1 :: ys1, x2 :: ys2) -> if eq x1 x2 then equal eq ys1 ys2 else false
    | _                      -> false
    end

  val show sh =
    let rec aux xs =
      match xs with
      | []      -> ` `
      | [x]     -> sh x
      | x :: ys -> sh x ^ `, `# ^ aux ys
      end
    in
    (fun xs -> `[` ^ aux xs ^ `]`)

  val rec fold f acc ys =
    match ys with
    | []      -> acc
    | x :: xs -> fold f (f acc x) xs
    end

  val fold-indexed f =
    let rec aux i f acc ys =
      match ys with
      | []      -> acc
      | x :: xs -> aux (i + 1) f (f acc i x) xs
      end
    in
    aux 0 f

  val rec fold-back f ys acc =
    match ys with
    | []      -> acc
    | x :: xs -> f x (fold-back f xs acc)
    end

  val fold-adjacent f =
    let rec aux prev-opt acc xs =
      match xs with
      | [] ->
          acc
      | head :: [] ->
          f acc head prev-opt None
      | head :: ((right :: _) as tail) ->
          let acc-new = f acc head prev-opt (Some(right)) in
          aux (Some(head)) acc-new tail
      end
    in
    aux None

  val fold-indexed-adjacent f init xs =
    let (_, acc) =
      xs |> fold-adjacent (fun p x prev-opt next-opt ->
        let (i, acc) = p in
        (i + 1, f acc i x prev-opt next-opt)
      ) (0, init)
    in
    acc

  val reverse xs =
    fold (fun acc x -> x :: acc) [] xs

  val rec map f ys =
    match ys with
    | []      -> []
    | x :: xs -> (f x) :: map f xs
    end

  val map-indexed f =
    let rec aux i f ys =
      match ys with
      | []      -> []
      | x :: xs -> (f i x) :: aux (i + 1) f xs
      end
    in
    aux 0 f

  val map-adjacent f xs =
    xs |> fold-adjacent (fun acc x prev-opt next-opt ->
      f x prev-opt next-opt :: acc
    ) [] |> reverse

  val map-indexed-adjacent f xs =
    xs |> fold-indexed-adjacent (fun acc i x prev-opt next-opt ->
      f i x prev-opt next-opt :: acc
    ) [] |> reverse

  val map-with-ends f xs =
    fold-adjacent (fun acc x prev-opt next-opt ->
      let is-first = Option.is-none prev-opt in
      let is-last = Option.is-none next-opt in
      let y = f is-first is-last x in
      y :: acc
    ) [] xs |> reverse

  val rec append xs1 xs2 =
    match xs1 with
    | []      -> xs2
    | x :: xs -> x :: append xs xs2
    end

  val concat xs =
    fold-back append xs []

  val pure x =
    [x]

  val bind xs f =
    concat (map f xs)

  val rec iter f ys =
    match ys with
    | []      -> ()
    | x :: xs -> let () = f x in iter f xs
    end

  val iter-indexed f =
    let rec aux i f ys =
      match ys with
      | []      -> ()
      | x :: xs -> let () = f i x in aux (i + 1) f xs
      end
    in
    aux 0 f

  val rec filter p ys =
    match ys with
    | []      -> []
    | x :: xs -> if p x then x :: filter p xs else filter p xs
    end

  val rec filter-map f ys =
    match ys with
    | [] ->
        []
    | x :: xs ->
        match f x with
        | None    -> filter-map f xs
        | Some(v) -> v :: filter-map f xs
        end
    end

  val rec find p ys =
    match ys with
    | []      -> None
    | x :: xs -> if p x then Some(x) else find p ys
    end

  val find-map f =
    let rec aux ys =
      match ys with
      | [] ->
          None
      | x :: xs ->
          match f x with
          | Some(v) -> Some(v)
          | None    -> aux xs
          end
      end
    in
    aux

  val length xs =
    fold (fun i elem -> i + 1) 0 xs

  val nth n =
    let rec aux i ys =
      match ys with
      | []      -> None
      | x :: xs -> if i == n then Some(x) else aux (i + 1) xs
      end
    in
    aux 0

  val is-empty xs =
    match xs with
    | []     -> true
    | _ :: _ -> false
    end

  val zip-exact ys1 ys2 =
    let rec aux acc ys1 ys2 =
      match (ys1, ys2) with
      | (x1 :: xs1, x2 :: xs2) -> aux ((x1, x2) :: acc) xs1 xs2
      | ([], [])               -> Some(reverse acc)
      | _                      -> None
      end
    in
    aux [] ys1 ys2

  val zip-shorter ys1 ys2 =
    let rec aux acc ys1 ys2 =
      match (ys1, ys2) with
      | (x1 :: xs1, x2 :: xs2) -> aux ((x1, x2) :: acc) xs1 xs2
      | ([], _)                -> reverse acc
      | (_, [])                -> reverse acc
      end
    in
    aux [] ys1 ys2

end
