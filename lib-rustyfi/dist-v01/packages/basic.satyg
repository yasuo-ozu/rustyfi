% basic.satyg — SATySFi 0.1 stdlib `Basic`, vendored for Legacy packaging
% (docs/plans/rustyfi-0-1-0-support.md §2 P2 / §4 phase 6).
% Source: saphe-split@b836d512:lib-rustyfi/packages/stdlib/stdlib.0.0.1/
%   src/basic.satyg — transliteration deltas:
%   - Wave 4 Batch C RESTORATION: `signature Ord = sig type t :: o val
%     compare : t -> t -> ordering end`, restored verbatim (additive only —
%     every other line of this file is untouched). Originally T6-dropped
%     (superseded note below, kept for the historical record) because named
%     signatures (Sub-slice 2d-3) were unbuilt at wave 0. 2d-3/2d-3b/2f-2a/
%     2f-2b have since landed the full module-qualified named-signature
%     path (`SigBotV1::Path`, `v1/module_check.rs::resolve_named_sig` +
%     `v1/surface.rs::outward_candidates`'s bare-suffix fallback — proven
%     cross-FILE by `compile_document_v1`'s single `SurfaceEnv` threaded
%     across the loader's dependency order, `lib.rs:191-203`, and by
%     `v01_sealing.rs`'s I9/I9b same-file precedent), so `map.satyg` and
%     `set.satyg` can now reference this signature as `Basic.Ord` from
%     their own separate files (proven by this package's own
%     `v01_map_set.rs` compile test).
%   - SUPERSEDED (kept for history, no longer in effect): T6 originally
%     dropped `signature Ord` outright. `signature` (named signature
%     declarations, Sub-slice 2d-3) was unbuilt in this port; its only
%     upstream consumers are the functor packages (`map.satyg`/`set.satyg`),
%     themselves BLOCKED on 2f (functors) and out of that wave — nothing in
%     Wave 0/1 referenced `Ord`.
%   Everything else is byte-identical: `Basic` is an UNSEALED module (no
%   `:>`), so its `ordering`/`vector`/`point`/`paren`/`paddings` type
%   synonyms and the `Less`/`Equal`/`Greater` constructors are exported as
%   `Basic.ordering` etc. (types; LONG_LOWER, Sub-slice 2d-2) and bare
%   (constructors; the "Ctor carve-out", `v1/lower.rs:152-159` — ctors
%   never carry module qualification in this port, sealed or not).

module Basic = struct

  type ordering = Less | Equal | Greater

  type vector = length * length

  type point = length * length

  type paren = length -> length -> context -> inline-boxes * (length -> length)

  type paddings = length * length * length * length

  signature Ord = sig
    type t :: o
    val compare : t -> t -> ordering
  end

end
