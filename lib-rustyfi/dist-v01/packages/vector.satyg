% vector.satyg — SATySFi 0.1 stdlib `Vector`, vendored for Legacy packaging
% (docs/plans/rustyfi-0-1-0-support.md §2 P2 / §4 phase 6).
% Source: saphe-split@b836d512:lib-rustyfi/packages/stdlib/stdlib.0.0.1/
%   src/vector.satyg — transliteration deltas:
%   - T1: `use open Basic` / `use Float` / `use Length` / `use Pair`
%     dropped; `@require: basic`, `@require: float`, `@require: length`,
%     `@require: pair` added.
%   - T2: bare `vector` (Basic's synonym) -> `Basic.vector` in the sig and
%     the `type t` synonym.
%   - T3: the `~lift` member (`Pair.lift Length.lift Length.lift`, itself
%     composed entirely of OTHER `~lift` members — all dropped together)
%     and its sig line dropped outright.

@require: basic
@require: float
@require: length
@require: pair

module Vector :> sig
  type t = Basic.vector
  val get-x : Basic.vector -> length
  val get-y : Basic.vector -> length
  val scale : float -> Basic.vector -> Basic.vector
  val add : Basic.vector -> Basic.vector -> Basic.vector
  val subtract : Basic.vector -> Basic.vector -> Basic.vector
  val length : Basic.vector -> length
end = struct

  type t = Basic.vector

  val get-x =
    Pair.first

  val get-y =
    Pair.second

  val scale t (x, y) =
    (x *' t, y *' t)

  val add (x1, y1) (x2, y2) =
    (x1 +' x2, y1 +' y2)

  val subtract (x1, y1) (x2, y2) =
    (x1 -' x2, y1 -' y2)

  val length (x, y) =
    let sx = x /' 1pt in
    let sy = y /' 1pt in
    1pt *' Float.sqrt (sx *. sx +. sy *. sy)

end
