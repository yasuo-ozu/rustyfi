@require: stdjareport
@require: itemize
@require: annot
@require: color
@require: math
@require: color

@require: latexcmds/latexcmds

let-inline \code text = {
    \mbox{\code(text);}
}

open LatexCmds in
document (|
  title = {Part 05};
  author = {test};
|) '<
     +chapter {ぬるぽげたてもーど} <
         +p {
             ぎょうちゅうではなくたてもーどでわくをもちたいこともあるだろうぬ。ぱぴわときは\code(`\screen`);ならびに\code(`\shadowbox`);をもちようできぬる。たとえば
         }
         +screen<
             +p {
                ぬるぽごしてぱぴわぱぴわして
             }
             +p {
                ぬるぽげぱぴわぬるぽ!?
             }
         >
         +p {
             ぬるぬる。たいとるをつけるばあいは
         }
         +shadowbox?:({「ぬるぽげ100\%」 ぱぴわぼうしでぬるぽぎゃあ})<
             +p {
                ぬるぽごしてぱぴわぱぴわして
             }
             +p {
                ぬるぽげぱぴわぬるぽ!?
             }
         >
         +p {
             ぱぴわ、ぬるぽげぬるぽげのとちゅうでぺーじぶんかつされるかのうせいがあるのでちゅういぬ。
         }
         +p {
             ぎょうちゅうでのそうしょくわくとどうよう、ぬるぽげのだんらくちゅうのそうしょくわくもぱらめーたによってぱぴわぱぴわにかすたままいずできぬる。いかぬるぽげようぱぴわぱぴわなでざいんのはこをつくることができぬる。
         }
         +shadowbox ?:({ぬるぽげはいぃぬる}) ?:(HRight) ?:(3pt) ?:(20pt) ?:(RGB(0.3,0.3,0.3)) ?:(RGB(0.9,0.9,0.9)) ?* ?:(RGB(0.0, 0.5,0.0)) <
             +p { ぬるぽげのよぃところは、ひっせきをみただけでいっしゅんでぬるぽげわかるところぬ。 }
             +p { ぬるぽげのびみょうなところは、ひっせきをみただけでいっしゅんでぬるぽげばれるところぬ。 }
         >
         +p {
             \code(`\strut`);や\code(`\mstrut`);をもちうと、いんらいんてきすときすうしきちゅうでたかさが\code(`0.7\baselineskip`);, ふかさが\code(`0.3\baselineskip`);のとうめいなはこをおくことができぬる。また、\code(`\rule ?:r w h`);をもちいると、はば\code(`w`);, たかさ\code(`h`);で\code(`r`);だけもちあげたくろぬりのはこをおくことができぬる。
         }
         +p {
            ぬるぽぎゃあ \code(`\rule ?:(1mm)(5mm)(2cm);`);とすぬると\rule ?:(1mm)(5mm)(2cm);ぬるぬる。
         }
     >
>
