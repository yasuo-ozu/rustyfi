@require: stdjareport
@require: itemize
@require: annot
@require: code
@require: gr

@require: easytable/easytable
@require: enumitem/enumitem

@require: base/typeset/base
@require: figbox/figbox

open FigBox
open EasyTableAlias

let-inline \link url text =
  let ibf ctx =
    let ctx = ctx |> set-text-color (Color.of-css `darkblue`) in
    read-inline ctx text
  in
  {\href(url){\eval(ibf);}}

let-block ctx +ctx ctxflst bt = read-block (ctxflst |> List.fold-left (fun ctx ctxf -> ctxf ctx) ctx) bt

let document record content = StdJaReport.document record '<%
  +ctx[
    set-font-size 12pt;
    set-paragraph-margin 12pt 12pt;
    set-leading (12pt *' 1.6);
    set-code-text-command (command \code);
  ](content);
>%

let-block ctx +block-frame bt =
  let decoset = VDecoSet.simple-frame 0.5pt Color.black Color.white in
  block-frame-breakable ctx (5pt, 5pt, 10pt, 10pt) decoset (fun ctx -> read-block ctx bt)

let-block +code code = 
  '<+ctx[set-font-size 10pt; set-paragraph-margin 6pt 6pt; set-leading 16pt;]<+Code.code(code);>>

let-block +example str bt =
  '<%
    +code(str);
    +block-frame(bt);
  >%

let-inline \pang = {The quick brown fox jumps over the lazy dog.}

let-inline \lipsum = {
  Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
  Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
  Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.
  Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
}

let-inline \jugem = {
寿限無，寿限無，五劫のすりきれ，
海砂利水魚の水行末・雲来末・風来末，
食う寝るところに住むところ，
やぶら小路のぶら小路，
パイポパイポ，パイポのシューリンガン，
シューリンガンのグーリンダイ，
グーリンダイのポンポコピーのポンポコナーの長久命の長助．
}


in
document (|
  title = {Part 05};
  author = {test};
|) '<
+chapter{りふぼっくす を うめこむ こまんど}<%

  +p{
    `+fig-block` は `fig-center` と にていますが、
    おぷしょん ひきすう に `align-left`, `align-center`, `align-right` をとり、
    ぞろえる いち を えらぶ こと ができます。
  }

  +example(```
    +fig-block ?:(align-left) (
      dummy-box 80pt 100pt |> rotate 90.
    );
    +fig-block ?:(align-center) (
      dummy-box 80pt 100pt |> rotate 90.
    );
    +fig-block ?:(align-right) (
      dummy-box 80pt 100pt |> rotate 90.
    );
  ```)<%
    +fig-block ?:(align-left) (
      dummy-box 80pt 100pt |> rotate 90.
    );
    +fig-block ?:(align-center) (
      dummy-box 80pt 100pt |> rotate 90.
    );
    +fig-block ?:(align-right) (
      dummy-box 80pt 100pt |> rotate 90.
    );
  >%

  +p{
    `+fig-abs-pos` および `\fig-abs-pos` は しめん に たいする ぜったい ざひょう を していして びょうが するため の こまんど です。
    それ じしん は それぞれ おおきさ ゼロ の ぶろっく ぼっくす れつ および いんらいん ぼっくす れつ として ふるまいます。
  }

  +example(```
    +fig-abs-pos((30pt, 50pt))(
      vconcat [
        dummy-box 80pt 100pt;
        gap 5pt;
        textbox {↑ぜったい ざひょう を していして びょうが する れい。}
      ]
    );
  ```)<%
    +fig-abs-pos((30pt, 50pt))(
      vconcat [
        dummy-box 80pt 100pt;
        gap 5pt;
        textbox {↑ぜったい ざひょう を していして びょうが する れい。}
      ]
    );
  >%

  +p{
    `\fig-inline` を つかえば、 つうじょう の いんらいん てきすと の なか に `figbox` を うめこむ こと ができます。
    がぞう や ろご を てきすと ちゅう に いれるとき など に じゅうほう するかもしれません。
  }

  +example(```
    +p{つまり わたしら は \fig-inline(
      textbox{${E=mc^2}} |> hvmargin 5pt |> frame 1pt Color.red
    ); という しき を みちびいた のである。}
  ```)<%
    +p{つまり わたしら は \fig-inline(
      textbox{${E=mc^2}} |> hvmargin 5pt |> frame 1pt Color.red
    ); という しき を みちびいた のである。}
  >%

  +p{
    `\fig-inline` は おぷしょん ひきすう を ひとつ とり、 `align-top` など を していする こと で
    うめこむ さい に がぞう を ぎょう の どの いち を きじゅん にして おくか していする こと ができます。
  }

  +example(```
    +p{つまり わたしら は \fig-inline?:(align-top)(
      textbox{${E=mc^2}} |> hvmargin 5pt |> frame 1pt Color.red
    ); という しき を みちびいた のである。}
  ```)<%
    +p{つまり わたしら は \fig-inline?:(align-top)(
      textbox{${E=mc^2}} |> hvmargin 5pt |> frame 1pt Color.red
    ); という しき を みちびいた のである。}
  >%

>%
>
