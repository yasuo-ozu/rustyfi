@require: v01-mini

let () = register-document-information (|
  title = Some(`v01-strings`),
  subject = None,
  author = Some(`SATySFi Rust port`),
  keywords = [`bitwise`, `nfc`]
|) in
let bits = embed-string (arabic (band 5 3)) in
% base14 `FontMetrics` only covers ASCII (32-126, see rustyfi-pdf's
% `Base14Metrics::advance`), so the NFC-composed character itself (e.g.
% U+00E9) can't be placed on the page; instead this renders the OBSERVABLE
% effect of composition — `string-length` (Unicode-scalar-value count)
% drops from 2 ("e" + COMBINING ACUTE ACCENT) to 1 (the single precomposed
% "é") — an ASCII-only witness that `normalize-string-to-nfc` actually ran.
let nfc = normalize-string-to-nfc (string-unexplode [101, 769]) in
let nfc-len = embed-string (arabic (string-length nfc)) in
let open V01Mini in
document (| title = `v01-strings` |) '<
  +p { Bits: #bits;. }
  +p { NFC length: #nfc-len;. }
>
