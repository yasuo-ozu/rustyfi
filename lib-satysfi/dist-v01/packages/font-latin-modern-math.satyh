% font-latin-modern-math.satyh — SATySFi 0.1 font envelope
% `FontLatinModernMath`, Legacy stand-in (docs/plans/…/doc-class-capstone-
% road.md §3 G7 / CP6, `…/tmp/g6-g7-standins.md` §2.2).
% Source: saphe-split@b836d512:lib-satysfi/packages/font-latin-modern-math/
%   … — ENVELOPE-ONLY upstream (no .satyh); saphe synthesizes
% `FontLatinModernMath.main : font` (the only `math: true` font among the
% four G7 stand-ins) from satysfi-envelope.yaml `files[].opentype_single.
% name`. PORT STAND-IN: the `font` value is the abbrev STRING (G8: `font` ≡
% `string` under V0_1, `typecheck.rs:499`); `set-math-font` accepts it bare
% (not a `font * float * float` triple) and resolves it the same way
% `set-font`'s name-heuristic does. No `@require:`.

module FontLatinModernMath :> sig
  val main : font
end = struct
  val main = `lmodern`
end
