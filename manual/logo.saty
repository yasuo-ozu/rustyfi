% The Rustyfi logo — every mark on the page is a `satysfi-xpath` path.
%
% Kept beside `manual.saty` because it is dogfood of the same kind: the manual
% proves the port can typeset prose, this proves it can typeset vector art, and
% both are built by the port's own binary against an installed package.
%
% Build (see the header of ./Satyristes):
%   rustyfi-rust satyrographos install scripts/layout_fidelity_corpus/xpath \
%       --lib-root <lib-root>
%   rustyfi-rust --lib-root <lib-root> --font-dir <lib-root> \
%       -o ../assets/logo/rustyfi-logo.pdf logo.saty
@require: color
@require: math
@require: list
@require: xpath/xpath

%% ---- palette -------------------------------------------------------------
let c-rim        = Color.rgb 0.34 0.11 0.03
let c-oxide-deep = Color.rgb 0.42 0.15 0.05
let c-oxide      = Color.rgb 0.76 0.30 0.08
let c-oxide-dark = Color.rgb 0.60 0.22 0.06
let c-ember      = Color.rgb 0.97 0.68 0.26
let c-ivory      = Color.rgb 0.98 0.955 0.90
let c-guilloche  = Color.rgb 0.89 0.84 0.72
let c-ink        = Color.rgb 0.13 0.11 0.12
let c-shadow     = Color.rgb 0.22 0.07 0.02
let c-tooth-lit  = Color.rgb 0.63 0.27 0.10
let c-guilloche2 = Color.rgb 0.93 0.89 0.80

%% ---- geometry ------------------------------------------------------------
let tau = 6.283185307179586
let kappa = 0.5522847498307936   % circle-from-4-beziers magic constant

let pw = 300pt
let ph = 396pt
let cx = 150pt
let cy = 262pt

let r-tooth-tip  = 112pt
let r-tooth-base =  84pt
let r-rim        =  95pt   % outer dark rim
let r-bevel-out  =  91pt   % bright bevel, outer edge
let r-bevel-in   =  87pt   % bright bevel, inner edge
let r-page       =  79pt   % the ivory "page"
let r-bead       =  93pt

let n-teeth = 16
let n-ticks = 60
let n-beads = 72
let n-petal = 48

%% A full circle as one closed XPath, centred at the origin.
let circle-at-origin r =
    let k = r *' kappa in
    XPath.start-path (r, 0pt)
        |> XPath.bezier-to (r, k) (k, r) (0pt, r)
        |> XPath.bezier-to (0pt -' k, r) (0pt -' r, k) (0pt -' r, 0pt)
        |> XPath.bezier-to (0pt -' r, 0pt -' k) (0pt -' k, 0pt -' r) (0pt, 0pt -' r)
        |> XPath.bezier-to (k, 0pt -' r) (r, 0pt -' k) (r, 0pt)
        |> XPath.terminate-path

let circle c r = circle-at-origin r |> XPath.shift-path c

%% A circular arc as ONE cubic bezier (exact to ~1e-4 for spans under a right
%% angle): k = 4/3 · tan(span/4) · r along the tangents at each end. SATySFi has
%% no gradients, so every specular highlight here is one of these laid on a ring.
let arc r a0 a1 =
    let k = r *' (1.3333333333 *. (tan ((a1 -. a0) /. 4.0))) in
    let p0 = (r *' (cos a0), r *' (sin a0)) in
    let p1 = (r *' (cos a1), r *' (sin a1)) in
    let c1 = (r *' (cos a0) -' k *' (sin a0), r *' (sin a0) +' k *' (cos a0)) in
    let c2 = (r *' (cos a1) +' k *' (sin a1), r *' (sin a1) -' k *' (cos a1)) in
    XPath.start-path p0 |> XPath.bezier-to c1 c2 p1 |> XPath.terminate-path

let rotate-path th p =
    XPath.linear-transform-path (cos th) (0.0 -. (sin th)) (sin th) (cos th) p

%% Fold one shape rotated `n` ways into a SINGLE path, so the whole ring of
%% copies is one `fill`. Every rotationally symmetric element below is built
%% this way: the teeth, the tick bezel, the beading, the guilloche.
let rosette n shape =
    let-rec go i acc =
        if i == n then acc
        else
            let th = tau *. (float i) /. (float n) in
            go (i + 1) (XPath.unite-path acc (rotate-path th shape))
    in
    go 1 shape

%% ---- the machined ring ---------------------------------------------------
%% One cog tooth, pointing along +y, slightly convex across the top so the ring
%% reads as machined rather than cut.
let tooth =
    let hb = 0.088 in
    let ht = 0.044 in
    let xb = r-tooth-base *' (sin hb) in
    let yb = r-tooth-base *' (cos hb) in
    let xt = r-tooth-tip *' (sin ht) in
    let yt = r-tooth-tip *' (cos ht) in
    let bulge = 1.2pt in
    XPath.start-path (0pt -' xb, yb)
        |> XPath.line-to (0pt -' xt, yt)
        |> XPath.bezier-to
             (0pt -' (xt *' 0.4), yt +' bulge)
             (xt *' 0.4, yt +' bulge)
             (xt, yt)
        |> XPath.line-to (xb, yb)
        |> XPath.close-with-line

let cog = rosette n-teeth tooth |> XPath.shift-path (cx, cy)

%% Fine radial marks in the oxide band.
let bezel =
    let hw = 0.55pt in
    let tick =
        XPath.start-path (0pt -' hw, 80.5pt)
            |> XPath.line-to (hw, 80.5pt)
            |> XPath.line-to (hw, 85.5pt)
            |> XPath.line-to (0pt -' hw, 85.5pt)
            |> XPath.close-with-line
    in
    rosette n-ticks tick |> XPath.shift-path (cx, cy)

%% Coin-edge beading just inside the rim.
let beading =
    rosette n-beads (circle-at-origin 0.85pt |> XPath.shift-path (0pt, r-bead))
        |> XPath.shift-path (cx, cy)

%% A guilloche: `n-petal` circles whose centres sit on a ring of the same
%% radius, so every one of them passes through the middle. Engine-turning, the
%% ornament a banknote or a watch dial is finished with — and, structurally,
%% the same rotate-and-unite as the teeth.
let guilloche =
    let d = 31pt in
    rosette n-petal (circle-at-origin d |> XPath.shift-path (0pt, d))
        |> XPath.shift-path (cx, cy)

%% A second rosette at a different petal count and radius. Two overlaid
%% engine-turnings interfere — the moire is the whole point of the technique on
%% a banknote, and it is what stops the pattern reading as a flat texture.
let guilloche-inner =
    let d = 23pt in
    rosette 31 (circle-at-origin d |> XPath.shift-path (0pt, d))
        |> XPath.shift-path (cx, cy)

%% ---- bevel shading -------------------------------------------------------
%% A band of concentric fills interpolating one colour into another. Four steps
%% look like banding; twelve read as a lit bevel.
let band r0 r1 (a0, a1, a2) (b0, b1, b2) n =
    let-rec go i =
        if i > n then []
        else
            let t = (float i) /. (float n) in
            let r = r0 +' ((r1 -' r0) *' t) in
            let c = Color.rgb (a0 +. ((b0 -. a0) *. t))
                              (a1 +. ((b1 -. a1) *. t))
                              (a2 +. ((b2 -. a2) *. t)) in
            (XPath.fill c (circle (cx, cy) r)) :: (go (i + 1))
    in
    go 0

%% A specular highlight, tapered. A single stroked arc has butt ends that read
%% as a seam rather than as light, and there are no gradients to fall off with —
%% so the highlight is `n` nested arcs, each shorter, narrower and closer to the
%% bright end. The union has soft ends in both width and colour.
let arc-stack r a0 a1 w n (p0, p1, p2) (q0, q1, q2) =
    let mid = (a0 +. a1) /. 2.0 in
    let span = (a1 -. a0) /. 2.0 in
    let-rec go i =
        if i > n then []
        else
            let t = (float i) /. (float n) in
            let k = 1.0 -. (0.62 *. t) in
            let c = Color.rgb (p0 +. ((q0 -. p0) *. t))
                              (p1 +. ((q1 -. p1) *. t))
                              (p2 +. ((q2 -. p2) *. t)) in
            (XPath.stroke (w *' k) c
                (arc r (mid -. (span *. k)) (mid +. (span *. k))
                    |> XPath.shift-path (cx, cy)))
                :: (go (i + 1))
    in
    go 0

%% ---- what sits inside the gear ------------------------------------------
%% No document. Drawing a sheet of paper — even a spare one — is depiction, and
%% the mark does not need to show the artefact when it can show the IDEA that
%% produces it.
%%
%% What is left is the abstraction every typesetter actually works against: a
%% BASELINE, an X-HEIGHT line above it, and a single set line resting between
%% them. Three elements. That is what typesetting is, before it is any
%% particular page, and it survives being shrunk to a favicon in a way a page
%% full of little grey bars never did.
let base-y   = cy -' 6.5pt          % the baseline, a shade below centre: optical, not metric
let x-height = 14pt
let half-w   = 60pt               % how far the rules run, just inside the margin guide
let set-w    = 46pt               % the one line that has been set

let rule y x0 x1 h =
    XPath.start-path (x0, y)
        |> XPath.line-to (x1, y)
        |> XPath.line-to (x1, y +' h)
        |> XPath.line-to (x0, y +' h)
        |> XPath.close-with-line

%% A rounded-cap bar. `x` is the left edge, `y` the BASELINE it sits on.
let bar x y w h =
    let cap = h *' 0.5 in
    XPath.start-path (x +' cap, y)
        |> XPath.line-to (x +' w -' cap, y)
        |> XPath.bezier-to (x +' w, y) (x +' w, y +' h) (x +' w -' cap, y +' h)
        |> XPath.line-to (x +' cap, y +' h)
        |> XPath.close-with-bezier (x, y +' h) (x, y)

let rect x0 y0 x1 y1 =
    XPath.start-path (x0, y0)
        |> XPath.line-to (x1, y0)
        |> XPath.line-to (x1, y1)
        |> XPath.line-to (x0, y1)
        |> XPath.close-with-line

%% An open path, for the dashed guide.
let hline y x0 x1 =
    XPath.start-path (x0, y) |> XPath.line-to (x1, y) |> XPath.terminate-path

%% Registration ticks where the rules end — the only ornament the interior gets.
let tick x y =
    XPath.start-path (x -' 0.4pt, y -' 2.6pt)
        |> XPath.line-to (x +' 0.4pt, y -' 2.6pt)
        |> XPath.line-to (x +' 0.4pt, y +' 2.6pt)
        |> XPath.line-to (x -' 0.4pt, y +' 2.6pt)
        |> XPath.close-with-line

%% The four metric lines, in descending authority: the baseline is solid
%% because it is not negotiable, the x-height dashed because it is a guide, and
%% cap and descender dotted because they are only reached when a letter reaches
%% them. Over them, ONE set line — with an ascender at its left and a descender
%% at its right, so all four lines are actually in use rather than decorative.
let cap-h    = 21pt
let desc-h   = 7pt
let stem-w   = 6.5pt

let interior =
    let x0 = cx -' half-w in
    let x1 = cx +' half-w in
    let xs = cx -' (set-w *' 0.5) in
    let guide w pat c y = XPath.dashed-stroke w pat c (hline y x0 x1) in
    List.concat
        %% Cap and descender are dotted: they are only reached when a letter
        %% reaches them. The x-height is dashed — a guide. The baseline is
        %% solid, because it is the one line that is not negotiable.
        [ [ guide 0.4pt (1.0pt, 3.2pt, 0pt) (Color.rgb 0.78 0.70 0.57) (base-y +' cap-h) ]
        ; [ guide 0.4pt (1.0pt, 3.2pt, 0pt) (Color.rgb 0.78 0.70 0.57) (base-y -' desc-h) ]
        ; [ guide 0.5pt (2.2pt, 2.6pt, 0pt) (Color.rgb 0.69 0.59 0.45) (base-y +' x-height) ]
        ; [ XPath.fill c-oxide-dark (rule base-y x0 x1 0.85pt) ]
        ; [ XPath.fill c-oxide-dark (tick x0 base-y) ]
        ; [ XPath.fill c-oxide-dark (tick x1 base-y) ]
          %% One set line, resting on the baseline, filling the x-height. It is
          %% the only solid mass inside the disc, so it is where the eye lands.
        ; [ XPath.fill c-oxide (bar xs base-y set-w x-height) ]
          %% The same light that falls on the ring falls on the type.
        ; [ XPath.fill (Color.rgb 0.91 0.49 0.17)
              (bar (xs +' 1.6pt) (base-y +' x-height -' 2.2pt) (set-w -' 3.2pt) 1.7pt) ]
        ; [ XPath.fill (Color.rgb 0.55 0.19 0.05)
              (bar (xs +' 1.6pt) (base-y +' 0.7pt) (set-w -' 3.2pt) 1.2pt) ]
        ]

let emblem =
    List.concat
        %% back to front
        [ [ XPath.fill c-shadow (cog |> XPath.shift-path (1.8pt, 0pt -' 1.8pt)) ]
        ; [ XPath.fill c-tooth-lit (cog |> XPath.shift-path (0pt -' 1.1pt, 1.1pt)) ]
        ; [ XPath.fill c-oxide-deep cog ]
        ; [ XPath.fill c-rim (circle (cx, cy) r-rim) ]
        ; [ XPath.fill c-ember (circle (cx, cy) r-bead) ]
        ; [ XPath.fill c-rim (circle (cx, cy) (r-bead -' 0.9pt)) ]
        ; [ XPath.fill c-ember (circle (cx, cy) r-bevel-out) ]
        ; band r-bevel-out r-bevel-in (0.97, 0.68, 0.26) (0.76, 0.30, 0.08) 12
        ; band r-bevel-in r-page (0.76, 0.30, 0.08) (0.60, 0.22, 0.06) 10
        ; [ XPath.fill c-ember beading ]
        %% Light from the upper left, shadow opposite.
        ; arc-stack 89.0pt 1.86 3.46 3.6pt 6 (0.97, 0.70, 0.30) (1.0, 0.95, 0.82)
        ; arc-stack 89.0pt 5.00 6.40 3.6pt 6 (0.70, 0.27, 0.08) (0.28, 0.09, 0.02)
        ; [ XPath.fill c-oxide-deep bezel ]
        %% The page is not a flat fill: it lifts towards the middle, the way a
        %% sheet does under a light.
        ; band r-page 12pt (0.975, 0.945, 0.885) (1.0, 0.993, 0.975) 10
        %% Engine-turning behind the text, hairline so it never competes.
        ; [ XPath.stroke 0.22pt c-guilloche guilloche ]
        ; [ XPath.stroke 0.18pt c-guilloche2 guilloche-inner ]
        ; [ XPath.stroke 1.5pt c-oxide-dark (circle (cx, cy) (r-page +' 0.4pt)) ]
        ; [ XPath.stroke 1.6pt (Color.rgb 1.0 0.995 0.98)
              (arc (r-page -' 1.4pt) 2.10 3.30 |> XPath.shift-path (cx, cy)) ]
        ; [ XPath.stroke 1.6pt (Color.rgb 0.87 0.82 0.72)
              (arc (r-page -' 1.4pt) 5.24 6.44 |> XPath.shift-path (cx, cy)) ]
        %% The margin guide is DERIVED from the page outline by `offset-path`,
        %% not drawn as its own circle — the operation `satysfi-xpath` has and
        %% the built-in path API does not.
        ; [ XPath.dashed-stroke 0.75pt (2.6pt, 3.0pt, 0pt) c-oxide-dark
              (XPath.offset-path 6pt (circle (cx, cy) r-page)) ]
        ; interior
        ]

%% ---- wordmark ------------------------------------------------------------
%% Modern logotype practice, and it suits a typesetter: a TIGHT lowercase
%% logotype carrying the weight, everything under it small and tracked wide.
%% The `fi` is set in oxide — the wordmark's accent, and in a program whose job
%% is setting type, the most famous ligature in the business.
let font-sans = (`lmsans`, 1.0, 0.0)
let font-mono = (`lmmono`, 1.0, 0.0)

let ctx-base =
    get-initial-context pw (command \math)
        |> set-dominant-narrow-script Latin
        |> set-text-color c-ink

let ctx-word ctx = ctx |> set-font-size 44pt |> set-font Latin font-sans

let ib-rusty ctx = read-inline (ctx-word ctx |> set-text-color c-ink) {rusty}
let ib-fi    ctx = read-inline (ctx-word ctx |> set-text-color c-oxide) {fi}

let wordmark ctx =
    line-break false false (ctx |> set-paragraph-margin 15pt 0pt)
        (inline-fil ++ ib-rusty ctx ++ ib-fi ctx ++ inline-fil)

%% The rule under the logotype is MEASURED, not guessed: `get-natural-metrics`
%% gives the set width of the same inline boxes, so the rule spans the logotype
%% exactly — and breaks colour exactly where the `fi` begins. Change the size or
%% the face and it still lines up.
let underrule ctx =
    let (w-all, _, _) = get-natural-metrics (ib-rusty ctx ++ ib-fi ctx) in
    let (w-dark, _, _) = get-natural-metrics (ib-rusty ctx) in
    let h = 1.3pt in
    line-break false false (ctx |> set-paragraph-margin 9pt 0pt)
        (inline-fil
            ++ inline-graphics w-all h 0pt (fun (x, y) -> (
                   [ XPath.fill (Color.rgb 0.58 0.55 0.56)
                       (rect x y (x +' w-dark) (y +' h))
                   ; XPath.fill c-oxide
                       (rect (x +' w-dark) y (x +' w-all) (y +' h)) ]
               ))
            ++ inline-fil)

%% Tracked-out, small, monospaced: the counterweight to a tight logotype.
let kicker ctx =
    let c =
        ctx |> set-font-size 7.6pt
            |> set-font Latin font-mono
            |> set-text-color c-oxide-dark
            |> set-paragraph-margin 11pt 0pt
    in
    line-break false false c
        (inline-fil ++ read-inline c {S A T Y S F I · N A T I V E L Y · I N · R U S T} ++ inline-fil)

%% A colophon line, which is the correct furniture for a typesetter's mark.
let colophon ctx =
    let c =
        ctx |> set-font-size 6.0pt
            |> set-font Latin font-mono
            |> set-text-color (Color.rgb 0.66 0.55 0.44)
            |> set-paragraph-margin 6pt 0pt
    in
    line-break false false c
        (inline-fil ++ read-inline c {T Y P E S E T · B Y · I T S E L F · E V E R Y · M A R K · A N · X P A T H · P A T H} ++ inline-fil)

%% ---- page ----------------------------------------------------------------
let body =
    let g =
        line-break false false ctx-base
            (inline-graphics pw (r-tooth-tip *' 2.0 +' 8pt) 0pt (fun (x, y) -> (
                emblem |> List.map (shift-graphics (x, y -' (cy -' r-tooth-tip -' 4pt)))
            )))
    in
    g +++ wordmark ctx-base +++ underrule ctx-base +++ kicker ctx-base +++ colophon ctx-base
in

page-break (UserDefinedPaper (pw, ph))
    (fun _ -> (|
        text-origin = (0pt, 20pt);
        text-height = ph;
    |))
    (fun _ -> (|
        header-origin  = (0pt, 0pt);
        header-content = block-nil;
        footer-origin  = (0pt, 0pt);
        footer-content = block-nil;
    |))
    body
