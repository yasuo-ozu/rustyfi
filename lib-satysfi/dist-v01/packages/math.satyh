%% -- for Latin Modern Math --
  val math ctx \int =
    let kernfL _ _ = 0pt in
    let kernfR fontsize ypos = fontsize *' 0.45 in
    math-big-char-with-kern ctx MathOp `∫` kernfL kernfR

%% -- for Cambria Math --
%  val math ctx \int =
%    let kernfL _ _ = 0pt in
%    let kernfR fontsize ypos = fontsize *' 0.2 in
%      math-big-char-with-kern MathOp `∫` kernfL kernfR

  val math ctx \dot-punct =
    math-char ctx MathPunct `.`


  % PORT: the upstream `paren`-parenthesization tail is DROPPED here —
  % `half-length`/`extract-spec-from-context`/`angle-left`/`angle-right`/
  % `paren-left`/`paren-right`/`brace-left`/`brace-right`/`sqbracket-left`/
  % `sqbracket-right`/`floor-left`/`floor-right`/`ceil-left`/`ceil-right`/
  % `abs-left`/`abs-right`/`norm-left`/`norm-right`/`empty-paren`/
  % `bar-middle`/`slash-middle`/`bracket-metrics`/`bracket-path`/
  % `floor-path`/`ceil-path`/`brace-left-long`, and the 12 math commands
  % that consume them (`\paren`, `\app`, `\angle-bracket`, `\brace`,
  % `\sqbracket`, `\floor`, `\ceil`, `\abs`, `\norm`, `\set`, `\setsep`,
  % `\cases`) — a genuine PRIMITIVE-TYPE gap (NOT this capstone task's to
  % fix; no `crates/*/src` edits were made): upstream 0.1's `type paren`
  % is `length -> length -> context -> inline-boxes * (length -> length)`
  % (`angle-left`/`paren-left`/… all end their curried argument list with
  % `ctx`, extracting fontsize/axis-height/color FROM the context via
  % `extract-spec-from-context`/`get-font-size`/`get-math-axis-height-
  % ratio`/`get-text-color`) — but this port's `prim_types.rs::t_paren()`
  % (consulted by `math-paren`/`math-paren-with-middle`'s v0.1 arms alike,
  % `prim_types.rs:1446-1480`) is UNCONDITIONALLY the 0.0.6 shape `length
  % -> length -> length -> length -> color -> …` (4 lengths + a bare
  % `color` argument, no `context`) — it was never retyped for the 0.1
  % math-split's context-based `paren`. Every upstream paren-family value
  % above fails to type-check against it (`while typing function
  % application: expected 'length', found 'context'`, empirically
  % confirmed against this exact file). This is reported, not
  % worked around: everything ABOVE this comment (all Greek letters, all
  % ~150 binary/relation/arrow/misc symbol commands, `\frac`/`\sqrt`/
  % `\lower`/`\upper`/`\text`/`\math-skip`/`\math-color`, the 6
  % `\mathord`/…/`\mathpunct` grouping commands, the 7 `\math-style`/
  % `\mathrm`/…/`\mathit` restyling commands (2 more, `\mathsf`/`\mathtt`,
  % separately T6-dropped above for the missing-ctor reason), `+math`/
  % `\eqn`/`+math-list`/`\math-list`/`+align`/`\align`, `\int`/`\dot-
  % punct`) is real, landed, and REACHABLE — std-ja's own sole touch-point
  % on this package, `command \Math.math`, does not need `paren` at all.

end
