;; Satyrographos manifest for the vendored `satysfi-xpath` sources, so the
;; package can be INSTALLED into a lib-root (`rustyfi-rust satyrographos
;; install .`) instead of being reached by a relative `@import:` into this
;; corpus tree. `(packageDir "xpath")` publishes `xpath/*.satyh` as
;; `dist/packages/xpath/`, which is what makes `@require: xpath/xpath` resolve.
;;
;; The library is self-contained: its four modules `@require: list` and
;; `@import:` only each other. `shared/` is used by `doc/xpath-doc.saty`, not
;; by the package, so it is deliberately not published here.
(version 0.0.2)

(library
  (name "xpath")
  (version "0.1.0")
  (sources
    ((packageDir "xpath"))))
