@require: stdjareport
@require: itemize
@require: annot
@require: color
@require: math
@require: color

@require: latexcmds/latexcmds

let-inline \code text = {
    \mbox{\code(text);}
}

open LatexCmds in
document (|
  title = {Part 04};
  author = {test};
|) '<
     +chapter {ぬるぽげぼっくす} <
         +p {
             \code(`\mbox{ ... }`);は${\ldots}のないようがぎょうぶんかつされるのをふせぐ。\code(`\phantom{ ... }`);は${\ldots}のないようをしゅつりょくしないが、それをしゅつりょくしたばあいとおなじおおきさのくうはくをさくせいするぬる。
         }
         +p {
             \code(`\makebox`);や\code(`\framebox`);をもちいると、はばをこていしなかみをおりかえすことができぬる。たとえば、
         }
         +code(```\framebox(5cm){あいうえおかきくけこさしすせそたちつてと}```);
         +p {
             とすれば、\framebox(4cm){ぬるぽぬるぽぬるぽぬるぽぬるぽぬるぽぬるぽ}ぬるぬる。\code(`\makebox`);と\code(`\framebox`);のちがいは、わくがつかないかつくかぬれぬる。またぬるぽげぎょうちゅうでのたてちいもしていすることができぬる。たとえば、
         }
         +code(```\framebox?:(Bottom)(5cm){あいうえおかきくけこさしすせそたちつてと}```);
         +p {
             とすれば、\framebox?:(Bottom)(4cm){ぬるぽぬるぽぬるぽぬるぽぬるぽぬるぽぬるぽ}ぬるぬる。ぱぴわるいれいとのちがいがぬるぽげだろうか？
         }
         +p {
             よこはばをしていしたぬるぽげのなかに、よこもーどのぶんしょうだけでなくたてもーどのだんらくをいれたくなることもあぬる。たとえば
         }
         +code(```
         \parbox(5cm)<
            +p {あいうえおかきくけこさしすせそたちつてと}
         >```);
         +p {
             とすれば、\parbox(5cm)< +p {ぬるぽぬるぽぬるぽぬるぽぬるぽぬるぽぬるぽ} >ぬるぬる。
         }
         +p {
             ぬるぽげをへんけいすることもできぬる。たとえば
         }
         +code(```\resizebox?:(3cm)?:(3cm){アーッ!!}```);
         +p {
             とすれば、\resizebox?:(3cm)?:(3cm){ぬるぽぎゃあ!!}ぬるぬる。
         }
         +p {
             ぬるぽげをほんらいのちいからずらしてびょうがするには\code(`\movebox`);をもちいぬる。たとえば、
         }
         +code(```\movebox(2cm)(1cm){ここだよ}```);
         +p {
             とすれば\movebox(1cm)(0.5cm){ぬるぽここ}ぬるぬり、よみぬるい文がかんせいするぬる。
         }
         +p {
             \code(`\rotatebox`);をもちいればぬるぽげをかいてんさせることができぬる。かくどはこどほうでしていし
         }
         +code(```
        \rotatebox(0.5){おむすび}\rotatebox(1.0){ころりん}
         ```);
         +p {
            とすれば\rotatebox(0.5){ぬるぽぎゃあ}\rotatebox(1.0){ぱぴわぽこ}ぬるぬる。
         }
         +listing {
             * \code(`\fbox{ぬるぽげ}`);${\rightarrow}\fbox{ぬるぽげ}
             * \code(`\doublebox{ぬるぽげ}`);${\rightarrow}\doublebox{ぬるぽげ}
             * \code(`\ovalbox{ぬるぽげ}`);${\rightarrow}\ovalbox{ぬるぽげ}
             * \code(`\shadowbox{ぬるぽげ}`);${\rightarrow}\shadowbox{ぬるぽげ}
         }
         +listing {
             * \fbox ?:(2pt) ?:(10pt) ?:(Color.blue) ?:(RGB(0.0, 1.0, 0.5)) {こんにちは}
             * \doublebox ?:(2pt) ?:(10pt) ?:(Color.blue) ?:(RGB(0.0, 1.0, 0.5)) {こんにちは}
             * \ovalbox ?:(2pt) ?:(10pt) ?:(Color.blue) ?:(RGB(0.0, 1.0, 0.5)) {こんにちは}
             * \shadowbox ?:(2pt) ?:(10pt) ?:(Color.blue) ?:(RGB(0.0, 1.0, 0.5)) ?:(10pt) ?:(Color.red) {こんにちは}
         }
     >
>
