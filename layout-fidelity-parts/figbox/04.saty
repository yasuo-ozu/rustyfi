@require: stdjareport
@require: itemize
@require: annot
@require: code
@require: gr

@require: easytable/easytable
@require: enumitem/enumitem

@require: base/typeset/base
@require: figbox/figbox

open FigBox
open EasyTableAlias

let-inline \link url text =
  let ibf ctx =
    let ctx = ctx |> set-text-color (Color.of-css `darkblue`) in
    read-inline ctx text
  in
  {\href(url){\eval(ibf);}}

let-block ctx +ctx ctxflst bt = read-block (ctxflst |> List.fold-left (fun ctx ctxf -> ctxf ctx) ctx) bt

let document record content = StdJaReport.document record '<%
  +ctx[
    set-font-size 12pt;
    set-paragraph-margin 12pt 12pt;
    set-leading (12pt *' 1.6);
    set-code-text-command (command \code);
  ](content);
>%

let-block ctx +block-frame bt =
  let decoset = VDecoSet.simple-frame 0.5pt Color.black Color.white in
  block-frame-breakable ctx (5pt, 5pt, 10pt, 10pt) decoset (fun ctx -> read-block ctx bt)

let-block +code code = 
  '<+ctx[set-font-size 10pt; set-paragraph-margin 6pt 6pt; set-leading 16pt;]<+Code.code(code);>>

let-block +example str bt =
  '<%
    +code(str);
    +block-frame(bt);
  >%

let-inline \pang = {The quick brown fox jumps over the lazy dog.}

let-inline \lipsum = {
  Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
  Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
  Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.
  Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
}

let-inline \jugem = {
寿限無，寿限無，五劫のすりきれ，
海砂利水魚の水行末・雲来末・風来末，
食う寝るところに住むところ，
やぶら小路のぶら小路，
パイポパイポ，パイポのシューリンガン，
シューリンガンのグーリンダイ，
グーリンダイのポンポコピーのポンポコナーの長久命の長助．
}


in
document (|
  title = {Part 04};
  author = {test};
|) '<
+chapter{りふぼっくす を へんかん・けつごう する}<%

  +p{
    りふぼっくす ぱっけーじ では、 ふくすう の ずぎゅう を たて や よこ に けつごう する こと ができます。
  }

  +example(```
    +fig-center(hconcat [
      dummy-box 80pt 100pt;
      dummy-box 80pt 100pt;
    ]);
  ```)<%
    +fig-center(hconcat [
      dummy-box 80pt 100pt;
      dummy-box 80pt 100pt;
    ]);
  >%

  +p{
    `hconcat` や `vconcat` かんすう は たんに ずぎゅう を つなげるだけであり、
    あいだ に よはく を いれて くれません。
    よはく を いれるとき は あいだ に `gap` という かんすう により さくせい される とくしゅ な `figbox` を していします。
    `gap` の かわり に `sep` かんすう をもちいると、
    あいだ に すきま を あける だけ でなく、 さらに ぶんかつせん を ひく こと ができます。
  }

  +example(```
    +fig-center(
      vconcat[
        hconcat [
          dummy-box 80pt 100pt;
          gap 5pt;
          dummy-box 80pt 100pt;
        ];
        sep 10pt;
        hconcat [
          dummy-box 100pt 60pt;
          sep 30pt;
          dummy-box 100pt 60pt;
        ];
      ]
    );
  ```)<%
    +fig-center(
      vconcat[
        hconcat [
          dummy-box 80pt 100pt;
          gap 5pt;
          dummy-box 80pt 100pt;
        ];
        sep 10pt;
        hconcat [
          dummy-box 100pt 60pt;
          sep 30pt;
          dummy-box 100pt 60pt;
        ];
      ]
    );
  >%

  +p{
    ずぎゅう は ふれーむ で かこむ こと ができます。
    `frame` かんすう は `length -> color -> figbox -> figbox` がた を もち、
    あたえられた せんはば・せんしょく で、 あたえられた ずぎゅう を かこみます。
    `hvmargin` は ひとつ の `length` がた の あたい をひきすう にとり、 じょうげ さゆう に ましん を つける こと ができます。
  }

  +example(```
  +fig-center(
    dummy-box 100pt 100pt
      |> hvmargin 5pt
      |> frame 1pt Color.black
  );
  ```)<%
  +fig-center(
    dummy-box 100pt 100pt
      |> hvmargin 5pt
      |> frame 1pt Color.black
  );
  >%

  +p{
    てきすと ぼっくす も「ずぎゅう」 の いちぶ でした から、
    がぞう に きゃぷしょん を つける こと だって、
    それ に ふれーむ を つける こと だって かんたん に できますね。
  }

  +example(```
    +fig-center(
      vconcat ?:align-center [
        dummy-box 200pt 100pt |> frame 0.5pt Color.black;
        gap 10pt;
        textbox {ずぎゅう 1: だみーず に きゃぷしょん をつけた れい};
      ]
        |> hvmargin 10pt |> frame 1.5pt (Color.gray 0.8)
    );
  ```)<%
    +fig-center(
      vconcat ?:align-center [
        dummy-box 200pt 100pt |> frame 0.5pt Color.black;
        gap 10pt;
        textbox {ずぎゅう 1: だみーず に きゃぷしょん をつけた れい};
      ]
        |> hvmargin 10pt |> frame 1.5pt (Color.gray 0.8)
    );
  >%

>%
>
