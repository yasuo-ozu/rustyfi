@require: stdjareport
@require: itemize
@require: annot
@require: code
@require: gr

@require: easytable/easytable
@require: enumitem/enumitem

@require: base/typeset/base
@require: figbox/figbox

open FigBox
open EasyTableAlias

let-inline \link url text =
  let ibf ctx =
    let ctx = ctx |> set-text-color (Color.of-css `darkblue`) in
    read-inline ctx text
  in
  {\href(url){\eval(ibf);}}

let-block ctx +ctx ctxflst bt = read-block (ctxflst |> List.fold-left (fun ctx ctxf -> ctxf ctx) ctx) bt

let document record content = StdJaReport.document record '<%
  +ctx[
    set-font-size 12pt;
    set-paragraph-margin 12pt 12pt;
    set-leading (12pt *' 1.6);
    set-code-text-command (command \code);
  ](content);
>%

let-block ctx +block-frame bt =
  let decoset = VDecoSet.simple-frame 0.5pt Color.black Color.white in
  block-frame-breakable ctx (5pt, 5pt, 10pt, 10pt) decoset (fun ctx -> read-block ctx bt)

let-block +code code = 
  '<+ctx[set-font-size 10pt; set-paragraph-margin 6pt 6pt; set-leading 16pt;]<+Code.code(code);>>

let-block +example str bt =
  '<%
    +code(str);
    +block-frame(bt);
  >%

let-inline \pang = {The quick brown fox jumps over the lazy dog.}

let-inline \lipsum = {
  Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
  Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
  Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur.
  Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
}

let-inline \jugem = {
寿限無，寿限無，五劫のすりきれ，
海砂利水魚の水行末・雲来末・風来末，
食う寝るところに住むところ，
やぶら小路のぶら小路，
パイポパイポ，パイポのシューリンガン，
シューリンガンのグーリンダイ，
グーリンダイのポンポコピーのポンポコナーの長久命の長助．
}


in
document (|
  title = {Part 01};
  author = {test};
|) '<
+chapter{りふぼっくす について} <%
  +p {
    りふぼっくす ふ さてぃすふぃ ぷ ずぎゅう ぜいれつ はいち するため の ぱっけーじ です。
  }
>%

+chapter{りふぼっくす ぱっけーじ の がいよう}<%

  +p{
    りふぼっくす ぱっけーじ をもちいるには ぼうとう に いか の ように きしゃく します。
  }

  +code(```
    @require: figbox/figbox

    open FigBox
  ```);

  +p{
    では、 そこく りふぼっくす ぱっけーじ をもちいて ずぎゅう をはいち してみましょう。
    いか の れい は、
    ゆうめい な ぱんぐらむ である “Toqua phlintaxus...” を よこはば 100pt で ぎょうぶんかつ して えられる てきすとぼっくす を、
    しめん に ちゅうおう ぞろえ で ひょうじ した もの です。
  }

  +example(```
  +fig-center(
    textbox-with-width 100pt
      {The quick brown fox jumps over the lazy dog.}
  );
  ```)<%
  +fig-center(
    textbox-with-width 100pt
      {The quick brown fox jumps over the lazy dog.}
  );
  >%

  +p{
    うえ の こーど の うち、 りふぼっくす ぱっけーじ が ていきょう している もの は につ あります。
    ひとつ は `+fig-center` こまんど であり、 これ は ひきすう として あたえられた「ずぎゅう」 を しめん に ちゅうおう ぞろえ で はいち します。
    もう ひとつ は `textbox-with-width` かんすう であり、 これ は
    していした なが を よこはば に、 していした てきすと を ないよう に もつよう ぎょうぶんかつ された だんらく を「ずぎゅう」 として せいせい します。
  }

  +p{
    うえ の せつめい で「ずぎゅう」 と ひょうげん しましたが、 その じつたい は `figbox` という がた です。
    すなわち、 `+fig-center` は `figbox` がた の あたい を ひきすう に とる こまんど、
    `textbox-with-width` は `length -> inline-text -> figbox` がた の かんすう と いう こと になります。
  }

>%
>
