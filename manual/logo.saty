% The Rustyfi logo — every mark on the page is a `satysfi-xpath` path.
%
% One file, deliberately: the geometry was briefly split into a `logo.satyh`
% library so `manual.saty` could carry the mark too, and that is gone. A
% document cannot be `@import:`ed, so the split only paid off while something
% else imported it.
%
% Build:  make -C manual logo      (see ./Makefile, and ./logo.md for the design)
@require: color
@require: math
@require: list
@require: xpath/xpath

let pw = 264pt
let ph = 264pt

%% ---- palette -------------------------------------------------------------
let c-rim        = Color.rgb 0.34 0.11 0.03
let c-oxide-deep = Color.rgb 0.42 0.15 0.05
let c-oxide      = Color.rgb 0.76 0.30 0.08
let c-oxide-dark = Color.rgb 0.60 0.22 0.06
let c-ember      = Color.rgb 0.97 0.68 0.26
let c-ivory      = Color.rgb 0.98 0.955 0.90
let c-guilloche  = Color.rgb 0.89 0.84 0.72
let c-ink        = Color.rgb 0.13 0.11 0.12
let c-shadow     = Color.rgb 0.22 0.07 0.02
let c-tooth-lit  = Color.rgb 0.63 0.27 0.10
let c-guilloche2 = Color.rgb 0.93 0.89 0.80

%% ---- geometry ------------------------------------------------------------
let tau = 6.283185307179586
let kappa = 0.5522847498307936   % circle-from-4-beziers magic constant

let pw = 264pt
let ph = 264pt
let cx = 132pt   % = pw/2; the mark is centred on its own page
let cy = 132pt   % = ph/2

let r-tooth-tip  = 112pt
let r-tooth-base =  84pt
let r-rim        =  95pt   % outer dark rim
let r-bevel-out  =  91pt   % bright bevel, outer edge
let r-bevel-in   =  87pt   % bright bevel, inner edge
let r-page       =  79pt   % the ivory "page"
let r-bead       =  93pt

let n-teeth = 16
let n-ticks = 60
let n-beads = 72
let n-petal = 48

%% A full circle as one closed XPath, centred at the origin.
let circle-at-origin r =
    let k = r *' kappa in
    XPath.start-path (r, 0pt)
        |> XPath.bezier-to (r, k) (k, r) (0pt, r)
        |> XPath.bezier-to (0pt -' k, r) (0pt -' r, k) (0pt -' r, 0pt)
        |> XPath.bezier-to (0pt -' r, 0pt -' k) (0pt -' k, 0pt -' r) (0pt, 0pt -' r)
        |> XPath.bezier-to (k, 0pt -' r) (r, 0pt -' k) (r, 0pt)
        |> XPath.terminate-path

let circle c r = circle-at-origin r |> XPath.shift-path c

%% A circular arc as ONE cubic bezier (exact to ~1e-4 for spans under a right
%% angle): k = 4/3 · tan(span/4) · r along the tangents at each end. SATySFi has
%% no gradients, so every specular highlight here is one of these laid on a ring.
let arc r a0 a1 =
    let k = r *' (1.3333333333 *. (tan ((a1 -. a0) /. 4.0))) in
    let p0 = (r *' (cos a0), r *' (sin a0)) in
    let p1 = (r *' (cos a1), r *' (sin a1)) in
    let c1 = (r *' (cos a0) -' k *' (sin a0), r *' (sin a0) +' k *' (cos a0)) in
    let c2 = (r *' (cos a1) +' k *' (sin a1), r *' (sin a1) -' k *' (cos a1)) in
    XPath.start-path p0 |> XPath.bezier-to c1 c2 p1 |> XPath.terminate-path

let rotate-path th p =
    XPath.linear-transform-path (cos th) (0.0 -. (sin th)) (sin th) (cos th) p

%% Fold one shape rotated `n` ways into a SINGLE path, so the whole ring of
%% copies is one `fill`. Every rotationally symmetric element below is built
%% this way: the teeth, the tick bezel, the beading, the guilloche.
let rosette n shape =
    let-rec go i acc =
        if i == n then acc
        else
            let th = tau *. (float i) /. (float n) in
            go (i + 1) (XPath.unite-path acc (rotate-path th shape))
    in
    go 1 shape

%% ---- the machined ring ---------------------------------------------------
%% One cog tooth, pointing along +y, slightly convex across the top so the ring
%% reads as machined rather than cut.
let tooth =
    let hb = 0.088 in
    let ht = 0.044 in
    let xb = r-tooth-base *' (sin hb) in
    let yb = r-tooth-base *' (cos hb) in
    let xt = r-tooth-tip *' (sin ht) in
    let yt = r-tooth-tip *' (cos ht) in
    let bulge = 1.2pt in
    XPath.start-path (0pt -' xb, yb)
        |> XPath.line-to (0pt -' xt, yt)
        |> XPath.bezier-to
             (0pt -' (xt *' 0.4), yt +' bulge)
             (xt *' 0.4, yt +' bulge)
             (xt, yt)
        |> XPath.line-to (xb, yb)
        |> XPath.close-with-line

let cog = rosette n-teeth tooth |> XPath.shift-path (cx, cy)

%% Fine radial marks in the oxide band.
let bezel =
    let hw = 0.55pt in
    let tick =
        XPath.start-path (0pt -' hw, 80.5pt)
            |> XPath.line-to (hw, 80.5pt)
            |> XPath.line-to (hw, 85.5pt)
            |> XPath.line-to (0pt -' hw, 85.5pt)
            |> XPath.close-with-line
    in
    rosette n-ticks tick |> XPath.shift-path (cx, cy)

%% Coin-edge beading just inside the rim.
let beading =
    rosette n-beads (circle-at-origin 0.85pt |> XPath.shift-path (0pt, r-bead))
        |> XPath.shift-path (cx, cy)

%% A guilloche: `n-petal` circles whose centres sit on a ring of the same
%% radius, so every one of them passes through the middle. Engine-turning, the
%% ornament a banknote or a watch dial is finished with — and, structurally,
%% the same rotate-and-unite as the teeth.
let guilloche =
    let d = 31pt in
    rosette n-petal (circle-at-origin d |> XPath.shift-path (0pt, d))
        |> XPath.shift-path (cx, cy)

%% A second rosette at a different petal count and radius. Two overlaid
%% engine-turnings interfere — the moire is the whole point of the technique on
%% a banknote, and it is what stops the pattern reading as a flat texture.
let guilloche-inner =
    let d = 23pt in
    rosette 31 (circle-at-origin d |> XPath.shift-path (0pt, d))
        |> XPath.shift-path (cx, cy)

%% ---- bevel shading -------------------------------------------------------
%% A band of concentric fills interpolating one colour into another. Four steps
%% look like banding; twelve read as a lit bevel.
let band r0 r1 (a0, a1, a2) (b0, b1, b2) n =
    let-rec go i =
        if i > n then []
        else
            let t = (float i) /. (float n) in
            let r = r0 +' ((r1 -' r0) *' t) in
            let c = Color.rgb (a0 +. ((b0 -. a0) *. t))
                              (a1 +. ((b1 -. a1) *. t))
                              (a2 +. ((b2 -. a2) *. t)) in
            (XPath.fill c (circle (cx, cy) r)) :: (go (i + 1))
    in
    go 0

%% A specular highlight, tapered. A single stroked arc has butt ends that read
%% as a seam rather than as light, and there are no gradients to fall off with —
%% so the highlight is `n` nested arcs, each shorter, narrower and closer to the
%% bright end. The union has soft ends in both width and colour.
let arc-stack r a0 a1 w n (p0, p1, p2) (q0, q1, q2) =
    let mid = (a0 +. a1) /. 2.0 in
    let span = (a1 -. a0) /. 2.0 in
    let-rec go i =
        if i > n then []
        else
            let t = (float i) /. (float n) in
            let k = 1.0 -. (0.62 *. t) in
            let c = Color.rgb (p0 +. ((q0 -. p0) *. t))
                              (p1 +. ((q1 -. p1) *. t))
                              (p2 +. ((q2 -. p2) *. t)) in
            (XPath.stroke (w *' k) c
                (arc r (mid -. (span *. k)) (mid +. (span *. k))
                    |> XPath.shift-path (cx, cy)))
                :: (go (i + 1))
    in
    go 0

%% ---- what sits inside the gear ------------------------------------------
%% The logotype itself, centred. Everything that used to sit under the emblem —
%% the metric diagram, the rule, the kicker, the colophon — is gone: the mark is
%% one object now, and one object is what a mark has to be to survive being put
%% in a corner at 32 px.
%%
%% OUTLINED, and outlined the hard way. Neither SATySFi nor this port exposes a
%% PDF text render mode, so there is no stroked type to ask for: the letters are
%% drawn twelve times around a small circle in the outline colour and once more
%% in the disc's own tone on top. What survives between the copies IS the
%% outline. It is a halo, not a true stroke — at very large sizes the corners
%% would show it — but at any size this mark is used it reads as outlined type.
%% `lmodern` in `lib-rustyfi/dist/hash/fonts.rustyfi-hash` is NOT Latin Modern
%% Roman: the abbrev points at `latinmodern-math.otf`, the same file `lmmath`
%% points at. Upstream's `lmroman10-regular.otf` is not in this port's roster at
%% all. The upright Latin letters this draws are that math font's text alphabet,
%% which is the right look here — but the name is misleading, so: checked.
let font-word = (`lmodern`, 1.0, 0.0)

let ctx-base =
    get-initial-context pw (command \math)
        |> set-dominant-narrow-script Latin
        |> set-text-color c-ink

%% Two rings, not one: a pale outer halo that lifts the type off the
%% engine-turning, and a dark inner contour that draws the letterform. Together
%% they read as engraved rather than as text laid on top of a pattern.
let outline-n = 16

let ctx-word ctx =
    ctx |> set-font-size 30pt
        |> set-font Latin font-word
        |> set-dominant-narrow-script Latin

%% The disc's own centre tone, so the letter interiors read as holes in the
%% type rather than as a lighter fill laid over it.
let c-disc-centre = Color.rgb 1.0 0.993 0.975
let c-brace       = Color.rgb 0.82 0.42 0.16

%% Every piece of type on the disc is engraved the same way: a pale ring offset
%% away from the light, a dark contour offset towards it, and the fill on top.
%% The radii scale with the type — a 2pt relief that models a 30pt logotype
%% closes the counters of a 15pt delimiter — so callers pass their own.
let engrave (px, py) rad mk c-fill =
    let ring r (ox, oy) c =
        let-rec go i =
            if i == outline-n then []
            else
                let th = tau *. (float i) /. (float outline-n) in
                (draw-text (px +' ox +' (r *' (cos th)), py +' oy +' (r *' (sin th))) (mk c))
                    :: (go (i + 1))
        in
        go 0
    in
    List.concat
        [ ring rad (rad *' 0.35, 0pt -' (rad *' 0.35)) (Color.rgb 0.95 0.83 0.60)
        ; ring (rad *' 0.45) (0pt -' (rad *' 0.12), rad *' 0.12) c-oxide-deep
        ; [ draw-text (px, py) (mk c-fill) ]
        ]

%% Draw an inline box centred on a point, rather than from its left edge.
let centred-text (px, py) ib =
    let (w, h, d) = get-natural-metrics ib in
    draw-text (px -' (w *' 0.5), py -' ((h -' d) *' 0.5)) ib

let logotype ctx =
    let cw = ctx-word ctx in
    let ib c = read-inline (cw |> set-text-color c) {rustyfi} in
    %% `{` and `}` are SATySFi's inline-text delimiters — the mode marker you
    %% cannot write a document without. Flanking the logotype with them says
    %% what this program eats, in the language's own notation. Set larger and
    %% lighter than the word so they read as brackets, not as letters.
    let cb = cw |> set-font-size 46pt in
    let ib-open  = read-inline cb (embed-string `{`) in
    let (w, h, d) = get-natural-metrics (ib c-ink) in
    let (wb, _, _) = get-natural-metrics ib-open in
    let gap = 6pt in
    %% Optical centring: on the CAP box, not on the em box — `rustyfi` has no
    %% capitals and one descender, so metric centring would sit it visibly low.
    let x = cx -' (w *' 0.5) in
    let y = cy -' ((h -' d) *' 0.5) in
    %% The rings are OFF-CENTRE, each towards its own light: the pale one down
    %% and right, away from the source, the dark contour up and left towards it.
    %% Concentric rings give a halo — type sitting on a pattern. Offset ones give
    %% relief, and the relief agrees with the light already falling on the ring.
    let ring rad (ox, oy) c =
        let-rec go i =
            if i == outline-n then []
            else
                let th = tau *. (float i) /. (float outline-n) in
                (draw-text (x +' ox +' (rad *' (cos th)), y +' oy +' (rad *' (sin th))) (ib c))
                    :: (go (i + 1))
        in
        go 0
    in
    let brace px str =
        let mk c = read-inline (cb |> set-text-color c) (embed-string str) in
        let (bw, bh, bd) = get-natural-metrics (mk c-brace) in
        engrave (px -' (bw *' 0.5), cy -' ((bh -' bd) *' 0.5)) 1.5pt mk c-brace
    in
    List.concat
        [ brace (x -' gap -' (wb *' 0.5)) `{`
        ; brace (x +' w +' gap +' (wb *' 0.5)) `}`
        ; ring 2.0pt (0.7pt, 0pt -' 0.7pt) (Color.rgb 0.95 0.83 0.60)
        ; ring 0.9pt (0pt -' 0.25pt, 0.25pt) c-oxide-deep
        ; [ draw-text (x, y) (ib c-disc-centre) ]
        ]

%% Four marks of SATySFi's own notation, set on the diagonals like the legend
%% on a coin: `\` opens an inline command, `+` a block one, `$` math mode, and
%% `@` a file header (`@require:`). Between them and the braces around the
%% logotype, every mode the language has is named on the mark.
%%
%% They come through `embed-string` on BACKTICK STRING literals rather than
%% being written as inline text, because three of the four are illegal there —
%% `@`, `;` and `$` are mode-switching tokens, and the lexer is right to refuse
%% them. Quoting the character as data is the way to typeset a character that
%% the surrounding syntax reserves.
let syntax-marks ctx =
    let c =
        ctx |> set-font-size 14pt
            |> set-font Latin font-word
            |> set-text-color c-oxide-dark
            |> set-dominant-narrow-script Latin
    in
    let r = 63pt in
    [ (`\`, 0.7853981634)      % NE — inline command
    ; (`+`, 2.3561944902)       % NW — block command
    ; (`$`, 3.9269908170)       % SW — math mode
    ; (`@`, 5.4977871438)       % SE — file header
    ] |> List.map (fun (mark, th) -> (
        centred-text (cx +' (r *' (cos th)), cy +' (r *' (sin th)))
            (read-inline c (embed-string mark))
    ))

%% The other delimiter GROUPS the language has, on the vertical axis: `(| |)`
%% opens a record, `< >` a block-text run. With `{ }` already round the
%% logotype, the three groups a document is actually built out of are all named.
%%
%% `[ ]` is deliberately absent. A list is a data literal, not a MODE, and the
%% inscription is about the modes — adding it would make the ring a punctuation
%% sampler rather than a statement.
let mark-ctx ctx =
    ctx |> set-font-size 16pt
        |> set-font Latin font-word
        |> set-dominant-narrow-script Latin

%% Engraved and centred: measure the box once to find the offset, then hand the
%% colour-parameterised maker to `engrave` so every copy is set identically.
let engraved-mark ctx (px, py) str =
    let cm = mark-ctx ctx in
    let mk c = read-inline (cm |> set-text-color c) (embed-string str) in
    let (w, h, d) = get-natural-metrics (mk c-oxide) in
    engrave (px -' (w *' 0.5), py -' ((h -' d) *' 0.5)) 0.62pt mk c-oxide

let group-marks ctx =
    [ (`(|`, 0pt -' 16pt, 59pt)
    ; (`|)`, 16pt, 59pt)
    ; (`<`, 0pt -' 14pt, 0pt -' 61pt)
    ; (`>`, 14pt, 0pt -' 61pt)
    ] |> List.map (fun (mark, dx, dy) -> (
        engraved-mark ctx (cx +' dx, cy +' dy) mark
    )) |> List.concat

let emblem-graphics ctx =
    List.concat
        %% back to front
        [ [ XPath.fill c-shadow (cog |> XPath.shift-path (1.8pt, 0pt -' 1.8pt)) ]
        ; [ XPath.fill c-tooth-lit (cog |> XPath.shift-path (0pt -' 1.1pt, 1.1pt)) ]
        ; [ XPath.fill c-oxide-deep cog ]
        ; [ XPath.fill c-rim (circle (cx, cy) r-rim) ]
        ; [ XPath.fill c-ember (circle (cx, cy) r-bead) ]
        ; [ XPath.fill c-rim (circle (cx, cy) (r-bead -' 0.9pt)) ]
        ; [ XPath.fill c-ember (circle (cx, cy) r-bevel-out) ]
        ; band r-bevel-out r-bevel-in (0.97, 0.68, 0.26) (0.76, 0.30, 0.08) 12
        ; band r-bevel-in r-page (0.76, 0.30, 0.08) (0.60, 0.22, 0.06) 10
        ; [ XPath.fill c-ember beading ]
        %% Light from the upper left, shadow opposite.
        ; arc-stack 89.0pt 1.86 3.46 3.6pt 6 (0.97, 0.70, 0.30) (1.0, 0.95, 0.82)
        ; arc-stack 89.0pt 5.00 6.40 3.6pt 6 (0.70, 0.27, 0.08) (0.28, 0.09, 0.02)
        ; [ XPath.fill c-oxide-deep bezel ]
        %% The page is not a flat fill: it lifts towards the middle, the way a
        %% sheet does under a light.
        ; band r-page 12pt (0.975, 0.945, 0.885) (1.0, 0.993, 0.975) 10
        %% Engine-turning behind the text, hairline so it never competes.
        ; [ XPath.stroke 0.22pt c-guilloche guilloche ]
        ; [ XPath.stroke 0.18pt c-guilloche2 guilloche-inner ]
        ; [ XPath.stroke 1.5pt c-oxide-dark (circle (cx, cy) (r-page +' 0.4pt)) ]
        ; [ XPath.stroke 1.6pt (Color.rgb 1.0 0.995 0.98)
              (arc (r-page -' 1.4pt) 2.10 3.30 |> XPath.shift-path (cx, cy)) ]
        ; [ XPath.stroke 1.6pt (Color.rgb 0.87 0.82 0.72)
              (arc (r-page -' 1.4pt) 5.24 6.44 |> XPath.shift-path (cx, cy)) ]
        %% The margin guide is DERIVED from the page outline by `offset-path`,
        %% not drawn as its own circle — the operation `satysfi-xpath` has and
        %% the built-in path API does not.
        ; [ XPath.dashed-stroke 0.75pt (2.6pt, 3.0pt, 0pt) c-oxide-dark
              (XPath.offset-path 6pt (circle (cx, cy) r-page)) ]
        ; logotype ctx
        ; syntax-marks ctx
        ; group-marks ctx
        ]


let ctx-page = get-initial-context pw (command \math)

let body =
    line-break false false ctx-page
        (inline-fil
            ++ inline-graphics pw ph 0pt (fun (x, y) -> (
                   emblem-graphics ctx-page |> List.map (shift-graphics (x, y))
               ))
            ++ inline-fil)
in

page-break (UserDefinedPaper (pw, ph))
    (fun _ -> (|
        %% Measured, not assumed: `inline-fil` centres the box horizontally and
        %% nothing centres it vertically, so the text area carries whatever
        %% correction the render actually needs. Verified by measuring the
        %% rendered ink's bounding box — equal margins on all four sides.
        %% Re-measure if the mark's size changes.
        text-origin = (0pt, 0pt);
        text-height = ph;
    |))
    (fun _ -> (|
        header-origin  = (0pt, 0pt);
        header-content = block-nil;
        footer-origin  = (0pt, 0pt);
        footer-content = block-nil;
    |))
    body
