% font-junicode.satyh — SATySFi 0.1 font envelope `FontJunicode`, Legacy
% stand-in (G7 / CP6, `…/tmp/g6-g7-standins.md` §2.2). Source:
% saphe-split@b836d512:lib-rustyfi/packages/font-junicode/… — this package
% is ENVELOPE-ONLY upstream (no .satyh); saphe synthesizes
% `FontJunicode.{normal,bold,italic,bold-italic} : font` from
% rustyfi-envelope.yaml `files[].opentype_single.name`, binding each to the
% internal `LoadSingleFont{path}` node. PORT STAND-IN: only the SHAPE of
% that synthesis is stood in for — this is an ordinary `.satyh` module the
% loader already resolves, whose members call the LOCAL `load-single-font`
% primitive (`prim_types.rs`/`primitives.rs`) in that node's place. The
% values ARE real `font` handles (`Value::Font(FontKey)`, upstream's
% `BCFontKey of FontKey.t`); what is stood in for is the KEY — this port's
% font-store abbrev rather than a font FILE path — so with a bare
% single-face `TtfFontStore` every abbrev collapses to the one loaded face.
% No `@require:`. Real 0.1 envelope font loading (Axis B) supersedes this
% later.

module FontJunicode :> sig
  val normal : font
  val bold : font
  val italic : font
  val bold-italic : font
end = struct
  val normal = load-single-font `Junicode`
  val bold = load-single-font `Junicode-b`
  val italic = load-single-font `Junicode-it`
  val bold-italic = load-single-font `Junicode-bi`
end
