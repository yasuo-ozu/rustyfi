% Probe 05 — enumitem's BLOCK-based `+itemize`/`+item` and the definition list
% `+description`/`+dd`, each between pure-CJK anchors.
@require: stdjabook
@import: ../../layout_fidelity_corpus/enumitem/src/enumitem

open EnumitemAlias

% `+dd` is defined in the corpus document itself, not the package.
let-block +dd dt it-dd = '< +ditem{#dt;}{#it-dd;}<> >

let-block ctx +ctx ctxflst bt =
  read-block (ctxflst |> List.fold-left (fun ctx ctxf -> ctxf ctx) ctx) bt

let document record bt = StdJaBook.document record '<%
  +ctx[fun ctx -> (
    let fsize = get-font-size ctx in
    ctx |> set-paragraph-margin fsize fsize
        |> set-leading (fsize *' 1.6)
  )](bt);
>%

in

document (|
  title = {あ};
  author = {あ};
  date = {あ};
  show-title = false;
  show-toc = false;
|) '<
  +p{あああああ。}
  +itemize(dot-arabic)<
    +item{かかかかか。}<
      +item{ききききき。}<>
    >
    +item{くくくくく。}<>
  >
  +p{いいいいい。}
  +description<
    +dd{けけけけけ}{こここここ。}
    +dd{さささささ}{しししししし。}
  >
  +p{ううううう。}
>
