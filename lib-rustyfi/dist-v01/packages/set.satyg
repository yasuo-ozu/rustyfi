% set.satyg — SATySFi 0.1 stdlib `Set` (Wave 4 Batch C), vendored for
% Legacy packaging. A real upstream FUNCTOR package built ON TOP of another
% vendored functor package: `module Make (Elem : Ord) = struct module Impl
% = Map.Make Elem … end` — cross-package functor application INSIDE a
% functor body (Sub-slice 2f-2a's `set.satyg` reference shape, already
% end-to-end proven by `v01_functors.rs`'s F-set1/F-set1-neg fixtures).
% Source: saphe-split@b836d512:lib-rustyfi/packages/stdlib/stdlib.0.0.1/
%   src/set.satyg — transliteration deltas:
%   - T1: `use open Basic` / `use List` / `use Map` -> `@require: basic` /
%     `@require: list` / `@require: map`.
%   - T2: bare `Ord` (the functor parameter's signature) -> `Basic.Ord`
%     (same module-qualified named-signature path as `map.satyg`; see that
%     package's banner for the resolution mechanism).
%   - NOTE (not a delta — confirms the same recent language landing
%     `map.satyg`'s banner documents): `Impl.fold`/`Impl.fold-back`'s `(fun
%     acc e () -> …)` callbacks (a `()`/unit lambda parameter, matching
%     `Impl`'s `'v = unit` instantiation) transliterate VERBATIM —
%     `Expr::Fun`'s params accept a full `PatBot` (incl. `Unit`), not just a
%     bare variable.
%   T3/T4 do not fire: no `persistent`/`~lift` members, no operator-section
%   expressions. T5: every upstream doc comment kept verbatim below.

@require: basic
@require: list
@require: map

module Set :> sig
  module Make : (Elem : Basic.Ord) -> sig
    type t :: o
    val empty : t
    val add : Elem.t -> t -> t
    val remove : Elem.t -> t -> t
    val is-member : Elem.t -> t -> bool
    val fold 'a : ('a -> Elem.t -> 'a) -> 'a -> t -> 'a
    val fold-back 'a : ('a -> Elem.t -> 'a) -> 'a -> t -> 'a
    val to-list : t -> list Elem.t
    val to-list-reversed : t -> list Elem.t
    val from-list : list Elem.t -> t
  end
end = struct

  module Make = fun(Elem : Basic.Ord) -> struct

    module Impl = Map.Make Elem

    type t = Impl.t unit

    val empty =
      Impl.empty

    val add e =
      Impl.add e ()

    val remove e =
      Impl.remove e

    val is-member e s =
      match Impl.find e s with
      | None    -> false
      | Some(_) -> true
      end

    val fold f acc s =
      Impl.fold (fun acc e () -> f acc e) acc s

    val fold-back f acc s =
      Impl.fold-back (fun acc e () -> f acc e) acc s

    val to-list s =
      Impl.fold-back (fun acc e () -> e :: acc) [] s

    val to-list-reversed s =
      Impl.fold (fun acc e () -> e :: acc) [] s

    % TODO: more efficient implementation
    val from-list es =
      Impl.from-list (List.map (fun e -> (e, ())) es)

  end

end
